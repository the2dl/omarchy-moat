#!/usr/bin/env bash
# omarchy-moat shim for makepkg.
#
#   1. scan the PKGBUILD with moat-scan-pkgbuild (exit 0 clean, 1 medium,
#      2 high). High findings prompt when interactive, refuse when not.
#   2. run the real makepkg under moat-sandbox.
#
# Installed as /usr/lib/moat/shims/makepkg; active only while
# /etc/moat/sandbox.enabled exists (see /etc/profile.d/moat-shims.sh).
#
# LIMITATIONS - read sandbox/README.md before filing a bug:
#   * The sandbox has no root and sets PR_SET_NO_NEW_PRIVS, so setuid binaries
#     do not elevate: `makepkg -s` / `-i` (pacman via sudo) will fail. Install
#     dependencies first and use --nodeps / -d, or run makepkg unsandboxed with
#     MOAT_SANDBOX=0.
#   * $PWD is writable, which covers the makepkg defaults (srcdir, pkgdir,
#     SRCDEST/PKGDEST/SRCPKGDEST/LOGDEST all default to the build directory).
#     If makepkg.conf points any of them elsewhere the shim adds an --allow for
#     that path; BUILDDIR under /tmp lands in the sandbox tmpfs and the
#     resulting package would be lost, so that case is refused with a hint.
set -euo pipefail
SHIM_SELF=${BASH_SOURCE[0]}
_shim_dir=${SHIM_SELF%/*}
[[ $_shim_dir == "$SHIM_SELF" ]] && _shim_dir=/usr/lib/moat/shims
# shellcheck source-path=SCRIPTDIR source=shim-common.sh
. "$_shim_dir/shim-common.sh"

# Subcommands / flags that query or output machine-readable data on stdout,
# and do not build or extract code.
makepkg_is_passthrough() {
	local arg
	for arg in "$@"; do
		case $arg in
		-h | --help | -V | --version) return 0 ;;
		esac
	done
	return 1
}

makepkg_scans() {
	local arg
	for arg in "$@"; do
		case $arg in
		--packagelist | --printsrcinfo | -g | --geninteg) return 1 ;;
		esac
	done
	return 0
}

makepkg_target_file() {
	local prev="" arg
	for arg in "$@"; do
		if [[ $prev == -p ]]; then
			printf '%s' "$arg"
			return 0
		elif [[ $arg == -p* ]]; then
			printf '%s' "${arg#-p}"
			return 0
		fi
		prev=$arg
	done
	printf 'PKGBUILD'
}

# ------------------------------------------------------- makepkg.conf paths ---

# Read a single assignment out of the makepkg config files without sourcing
# them (sourcing would execute config code outside the sandbox).
makepkg_conf_value() {
	local key=$1 file val="" line
	for file in /etc/makepkg.conf \
		/etc/makepkg.conf.d/*.conf \
		"${XDG_CONFIG_HOME:-$HOME/.config}/pacman/makepkg.conf" \
		"$HOME/.makepkg.conf"; do
		[[ -r $file ]] || continue
		while IFS= read -r line; do
			line=${line#"${line%%[![:space:]]*}"}
			[[ $line == "$key="* ]] || continue
			val=${line#"$key="}
			val=${val%%#*}
			val=${val%"${val##*[![:space:]]}"}
			val=${val#\"}
			val=${val%\"}
			val=${val#\'}
			val=${val%\'}
		done <"$file"
	done
	[[ -z $val ]] && return 0
	# The config file is not sourced, so ~ and $HOME arrive literally.
	# shellcheck disable=SC2088,SC2016 # matching the literal text, not expanding it
	case $val in
	'~/'*) val=$HOME/${val#'~/'} ;;
	'$HOME/'*) val=$HOME/${val#'$HOME/'} ;;
	esac
	# Anything still containing an unexpanded variable is unusable here.
	[[ $val == *'$'* ]] && return 0
	printf '%s' "$val"
}

add_allow_for() {
	local key=$1 val
	val=$(makepkg_conf_value "$key")
	[[ -n $val ]] || return 0
	[[ $val == /* ]] || return 0
	[[ $val == "$PWD" || $val == "$PWD"/* ]] && return 0
	if [[ $val == /tmp || $val == /tmp/* ]]; then
		printf '[moat] makepkg.conf sets %s=%s, which is inside the sandbox tmpfs;\n' "$key" "$val" >&2
		printf '[moat] the build output would be discarded. Point it outside /tmp or run with MOAT_SANDBOX=0.\n' >&2
		exit 1
	fi
	mkdir -p -- "$val" 2>/dev/null || true
	SHIM_SANDBOX_ARGS+=(--allow "$val")
}

# ------------------------------------------------------------------- main ---

if makepkg_is_passthrough "$@"; then
	shim_resolve makepkg
	PATH=$SHIM_PATH_REDUCED exec -- "$SHIM_REAL" "$@"
fi

_target=$(makepkg_target_file "$@")
if makepkg_scans "$@" && [[ -f ./$_target ]]; then
	if [[ $_target == PKGBUILD ]]; then
		shim_run_scan PKGBUILD moat-scan-pkgbuild .
	else
		shim_run_scan PKGBUILD moat-scan-pkgbuild "$_target"
	fi
fi

if [[ ${MOAT_SANDBOX:-1} != 0 && ${MOAT_SANDBOX_ACTIVE:-0} != 1 ]]; then
	for key in SRCDEST PKGDEST SRCPKGDEST LOGDEST BUILDDIR; do
		add_allow_for "$key"
	done
fi

shim_exec makepkg "$@"
