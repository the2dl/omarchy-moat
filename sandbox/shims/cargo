#!/usr/bin/env bash
# omarchy-moat shim for cargo.
#
#   1. for the subcommands that compile, scan the project with
#      moat-scan-cargo (build.rs, .cargo/config.toml, Cargo.toml, Cargo.lock)
#      before any build script or proc macro can run. Same contract as the
#      npm and makepkg shims: 0 clean, 1 medium warns, 2 high asks.
#   2. run the real cargo under moat-sandbox, but only for the subcommands
#      that fetch code from the network or execute code from the dependency
#      tree (build scripts, proc macros, test/bench harnesses).
#
# Sandboxed:  build install add fetch update run test check
#             (plus the aliases b, r, t, c and bench/clippy/doc, which all
#              compile the dependency graph and therefore run build.rs)
# Passed through: everything else (fmt, tree, metadata, --version, search,
#             login, new, init, clean, ...). Those either touch no third-party
#             code or need interactive/credential access that the sandbox
#             deliberately removes (cargo login writes ~/.cargo/credentials).
#
# Rationale: `cargo build` on an untrusted crate is arbitrary code execution
# via build.rs, which is exactly what the sandbox is for. `cargo fmt` is not,
# and sandboxing it only costs startup time and breaks editor integrations.
#
# Installed as /usr/lib/moat/shims/cargo; active only while
# /etc/moat/sandbox.enabled exists (see /etc/profile.d/moat-shims.sh).
set -euo pipefail
SHIM_SELF=${BASH_SOURCE[0]}
_shim_dir=${SHIM_SELF%/*}
[[ $_shim_dir == "$SHIM_SELF" ]] && _shim_dir=/usr/lib/moat/shims
# shellcheck source-path=SCRIPTDIR source=shim-common.sh
. "$_shim_dir/shim-common.sh"

# Subcommands that fetch, or that compile/run third-party code.
cargo_needs_sandbox() {
	case $1 in
	build | b | install | add | fetch | update | run | r | test | t | check | c) return 0 ;;
	bench | clippy | doc | rustc | miri | publish | package) return 0 ;;
	*) return 1 ;;
	esac
}

# Find the first bare word (the subcommand). Options before it are things like
# +toolchain, -v, --color=always, --config KEY=VAL.
subcmd=""
skip_next=0
for arg in "$@"; do
	if ((skip_next)); then
		skip_next=0
		continue
	fi
	case $arg in
	--config | -Z | --explain) skip_next=1 ;;
	+*) ;;
	-*) ;;
	*)
		subcmd=$arg
		break
		;;
	esac
done

if [[ -n $subcmd ]] && cargo_needs_sandbox "$subcmd"; then
	# `cargo build` on an untrusted crate is arbitrary code execution via
	# build.rs; that is the whole reason this subcommand list exists, so it is
	# also exactly the list worth scanning first. `cargo install foo` from a
	# directory with no manifest reads nothing local, and stays silent.
	if [[ -f ./Cargo.toml ]]; then
		shim_run_scan cargo moat-scan-cargo --for cargo .
	fi
	shim_exec cargo "$@"
fi

# Pass through unsandboxed.
shim_resolve cargo
PATH=$SHIM_PATH_REDUCED exec -- "$SHIM_REAL" "$@"
