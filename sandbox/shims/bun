#!/usr/bin/env bash
# omarchy-moat shim for bun.
#
#   1. for install-shaped subcommands, scan the package tree with
#      moat-scan-npm before any lifecycle script can run (same contract as
#      the npm and makepkg shims: 0 clean, 1 medium warns, 2 high asks).
#   2. run the real bun under moat-sandbox.
#
# Bare `bun` is the runtime, not an installer, so it is not scanned. bun only
# runs lifecycle scripts for packages on its trustedDependencies list, which
# makes it the least exposed of the four - but the lockfile rules still apply,
# and `bun install` still unpacks whatever the lockfile pins.
#
# bun.lockb is a binary format this scanner does not read; in a bun-only
# project the scan falls back to package.json plus node_modules, which is
# empty on a fresh clone. Keep a text lockfile (bun install --save-text-lockfile
# writes yarn.lock) if you want the lockfile rules.
#
# Installed as /usr/lib/moat/shims/bun; active only while
# /etc/moat/sandbox.enabled exists (see /etc/profile.d/moat-shims.sh).
set -euo pipefail
SHIM_SELF=${BASH_SOURCE[0]}
_shim_dir=${SHIM_SELF%/*}
[[ $_shim_dir == "$SHIM_SELF" ]] && _shim_dir=/usr/lib/moat/shims
# shellcheck source-path=SCRIPTDIR source=shim-common.sh
. "$_shim_dir/shim-common.sh"

bun_installs() {
	case $1 in
	install | i | add | a | update | link) return 0 ;;
	*) return 1 ;;
	esac
}

subcmd=$(shim_js_subcmd "$@")
if [[ -n $subcmd ]] && bun_installs "$subcmd"; then
	shim_scan_js_tree bun "$@"
fi

shim_exec bun "$@"
