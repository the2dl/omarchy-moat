# Maintainer: the omarchy-moat authors
#
# IMPORTANT: run makepkg from inside this directory (pkg/).
#
#     cd pkg && makepkg -f
#
# makepkg has no source type for "a sibling directory of the PKGBUILD"
# (`../moatd` is not a valid source= entry), so the components we build
# ourselves are copied out of the repository working tree in prepare() using
# $startdir/.. -- the standard pattern for a PKGBUILD that lives inside the
# repository it packages. That makes $startdir load-bearing: makepkg must be
# invoked with pkg/ as the working directory, and prepare() fails loudly if
# the repository root is not where it expects.

pkgname=omarchy-moat
pkgver=0.1.0
pkgrel=175
_tetragonver=1.7.1
pkgdesc='eBPF supply-chain sensor for Omarchy: Tetragon policies, an alert daemon, a bubblewrap sandbox and pre-execution scanners for PKGBUILD, npm, cargo, pip and go'
arch=('x86_64' 'aarch64')
url='https://github.com/the2dl/omarchy-moat'
# Apache-2.0: the bundled, unmodified Tetragon v1.7.1 (its eBPF objects are
# GPL-2.0, see /usr/share/licenses/omarchy-moat/LICENSE.tetragon-bpf).
# MIT: everything in this repository.
license=('Apache-2.0' 'MIT')
depends=(
	'bash'          # moat-sandbox, the shims and shim-common.sh
	'bubblewrap'    # moat-sandbox is a bwrap wrapper; hard dependency
	'python'        # the moat-scan-* scanners, stdlib only, python3
)
makedepends=('cargo')
optdepends=(
	'gum: interactive confirm prompt when the makepkg shim finds a high severity issue'
	'fish: the shim PATH snippet is also installed for fish'
)
# !debug + !lto: a Rust release build; cargo owns codegen, and the release
#   profile already sets strip = true, so there is nothing for makepkg to do.
# !strip: makepkg's tidy-install strips every ELF it finds, which rewrites the
#   94 upstream CO-RE BPF objects under /usr/lib/tetragon/bpf (26 sections down
#   to 17) and the two Go binaries. Tetragon is meant to ship byte-identical to
#   upstream, and a stripped BPF object is a CO-RE relocation waiting to fail.
options=('!debug' '!lto' '!strip')
install="${pkgname}.install"

# The Tetragon tarball checksum is the one published next to the release as
# tetragon-v1.7.1-amd64.tar.gz.sha256sum. Never SKIP: this is the one artifact
# in the package we do not build ourselves.
# The Tetragon release names its artifacts amd64/arm64 (not x86_64/aarch64),
# so `$CARCH` cannot be interpolated directly -- `_tetarch` is the mapping, and
# it is also the directory the tarball unpacks into.
case "$CARCH" in
	x86_64)  _tetarch=amd64 ;;
	aarch64) _tetarch=arm64 ;;
esac

# --- aarch64 only: the Tetragon RELEASE cannot start on a 16K-page kernel ----
#
# Apple Silicon runs CONFIG_ARM64_16K_PAGES=y, and v1.7.1 dies there before any
# moat policy is considered:
#
#   sensor __base__ failed to load: map tg_rb_events: map create:
#   invalid argument (ring map size 4096 not a multiple of page size 16384)
#
# The ring-buffer placeholder in bpf/lib/bpf_event.h is 4096 and the kernel
# wants a multiple of PAGE_SIZE. Upstream fixed it in PR #5027 (issue #5026),
# raising the placeholder to 65536 -- valid across 4K, 16K and 64K -- and
# merged it to main on 2026-05-25. v1.7.0 was cut in April, BEFORE that, and
# v1.7.1 is a patch on the v1.7 branch that never took the backport. So the
# newest release is the one release that cannot run on this hardware.
#
# Until a release carries it, aarch64 takes Tetragon from the CI build of main,
# pinned by OCI layer digest. A digest IS the sha256 of the blob, so the rule
# that the one artifact we do not build ourselves is never SKIP-checksummed
# still holds -- prepare() verifies each blob against the digest below and
# refuses on a mismatch.
#
# Everything comes from main TOGETHER. The 94 object names are identical
# between the two, but main is 830 commits ahead of v1.7.1, so pairing v1.7.1's
# userspace with main's BPF is the one combination nobody tests. `bpftool` is
# the single exception: main's image does not ship one, it is a standalone
# kernel tool rather than part of Tetragon, and nothing in moat or tetragon
# invokes it -- so it keeps coming from the release tarball.
#
# DELETE ALL OF THIS once a Tetragon release contains #5027: drop the digests,
# drop the prepare() hook, and aarch64 goes back to the tarball like x86_64.
# https://github.com/cilium/tetragon/pull/5027
_tetragon_ci_ref='quay.io/cilium/tetragon-ci@sha256:770ca23ad8b22011fe918fd9ba72c677ec0f1bce9b441e0ca285970087cc69ee'
_tetragon_ci_layers=(
	'sha256:f3fc0095f3f7abf9c615a58c811df19e6434c4e41be85a066d952ef70ea8b8db'  # usr/bin/tetragon
	'sha256:573ee5231bbbcb945524baf4034343ed81608ce12b42ea0079072f51596e4a71'  # usr/bin/tetra
	'sha256:a22adaf7282b31c9bff95e36348790f0a57e700bb610cae5085281bb09286fd4'  # usr/bin/gops
	'sha256:7578345112324c2217aa8b909a7c08b94337e487222bd7ced32b6fd03b369a0e'  # var/lib/tetragon/*.o
)

source=(
	"tetragon-${_tetragonver}-LICENSE::https://raw.githubusercontent.com/cilium/tetragon/v${_tetragonver}/LICENSE"
	"tetragon-${_tetragonver}-LICENSE.bpf::https://raw.githubusercontent.com/cilium/tetragon/v${_tetragonver}/bpf/LICENSE.GPL-2.0"
	'LICENSE.MIT'
	'scanner-allow.conf'
)
source_x86_64=("https://github.com/cilium/tetragon/releases/download/v${_tetragonver}/tetragon-v${_tetragonver}-amd64.tar.gz")
source_aarch64=("https://github.com/cilium/tetragon/releases/download/v${_tetragonver}/tetragon-v${_tetragonver}-arm64.tar.gz")

sha256sums=('f096c31ac0fb2e66df5b7ec20049741ae15accd50c8cd4d100b4db6c9353f6aa'
            '0d5bf346df9e635a29dcdddf832dc5b002ca6cdc1c5c9c6c567d2a61bb0c5c15'
            'bd2ac2c4267a46b64cb72015a57f64f63b40ba105b9c4824ff3ec6606f9dafd7'
            'af6f516a37ca5e5cbeef39fdf1db94c103b46dc92d30c805f267873a61acd048')
# Both from the .sha256sum published beside the release. Never SKIP: this is
# the one artifact in the package we do not build ourselves.
sha256sums_x86_64=('2f36a7bbb2b3d77a011383a01c8f804fe7761d934a76ff2fdf99ebad6f3e89ae')
sha256sums_aarch64=('aa71d12eddd962003e9fd78e3b3534185af5b2728c7d21ab3cb0f7fe2dc87702')

# One flag per file, Tetragon's own convention (CONTRACT section 2). All of
# them are backup= entries: they are the knobs a user turns.
_confd=(
	bpf-lib
	cgroup-rate
	enable-process-cred
	enable-process-ns
	enable-process-environment-variables
	event-queue-size
	export-allowlist
	export-file-compress
	export-file-max-backups
	export-file-max-size-mb
	export-filename
	filter-environment-variables
	gops-address
	health-server-address
	log-format
	log-level
	metrics-server
	parents-map-enabled
	process-cache-size
	server-address
	tracing-policy-dir
)

backup=(
	"${_confd[@]/#/etc/tetragon/tetragon.conf.d/}"
	etc/moat/moat.toml
	etc/moat/feeds.toml
	etc/moat/allowlist.d/default.toml
	# The shipped baseline (LEARNING section 8). It belongs to the package and
	# `moatctl allowlist` reports every entry in it as source=shipped,
	# removable=false -- but it is still under /etc and still a file a site
	# admin may narrow, so an edit must survive an upgrade as a .pacnew
	# rather than being silently reverted.
	etc/moat/allowlist.d/omarchy-default.toml
	etc/moat/sandbox.conf
	etc/moat/scanner-allow.conf
	# moat-ship's destination and redaction settings. Holds no secret as
	# shipped (prefer [https] token_file), but it is exactly the file a site
	# admin edits, so an upgrade must leave it alone.
	etc/moat/ship.toml
)

# The repository working tree, copied into $srcdir by prepare().
_tree="${pkgname}-tree"

# Fetch the pinned Tetragon CI layers and lay them over the release tarball.
#
# Only on aarch64, and only until a release carries PR #5027 -- see the long
# note beside `_tetragon_ci_layers`. `source=` cannot express this: quay needs a
# bearer token (anonymous, but still a header) that makepkg's download agents do
# not send, so the fetch lives here and does its own integrity check. That check
# is not weaker than makepkg's: an OCI digest is the sha256 of the blob, so
# comparing them is exactly what `sha256sums` would do.
_tetragon_from_ci() {
	local dir="${srcdir}/tetragon-v${_tetragonver}-${_tetarch}"
	local repo='cilium/tetragon-ci'
	local token blob got n=0

	token="$(curl -fsSL --max-time 60 \
		"https://quay.io/v2/auth?service=quay.io&scope=repository:${repo}:pull" \
		| python3 -c 'import json,sys; print(json.load(sys.stdin)["token"])')" || {
		error 'could not get a quay.io pull token for the Tetragon CI image'
		return 1
	}

	for blob in "${_tetragon_ci_layers[@]}"; do
		n=$((n + 1))
		msg2 "Tetragon CI layer ${n}/${#_tetragon_ci_layers[@]}"
		if ! curl -fsSL --max-time 600 -H "Authorization: Bearer ${token}" \
			"https://quay.io/v2/${repo}/blobs/${blob}" -o "${srcdir}/tglayer${n}.tgz"; then
			# CI images are garbage-collected eventually. When that happens this
			# is the message that has to be useful, because the build is dead
			# until somebody re-pins or a release ships the fix.
			error "Tetragon CI layer ${blob} is gone from quay.io."
			error 'Re-pin from a current tetragon-ci build, or switch aarch64 back'
			error 'to the release tarball if a release now contains PR #5027.'
			return 1
		fi
		got="sha256:$(sha256sum "${srcdir}/tglayer${n}.tgz" | cut -d' ' -f1)"
		if [[ ${got} != "${blob}" ]]; then
			error "Tetragon CI layer ${n}: expected ${blob}, got ${got}"
			return 1
		fi
	done

	# The CI image lays things out differently from the release tarball:
	# /usr/bin/{tetragon,tetra,gops} and a FLAT /var/lib/tetragon/*.o, against
	# the tarball's usr/local/{bin,lib/tetragon/bpf}. Overwrite in place so
	# package() keeps reading one layout and does not learn about any of this.
	local tmp="${srcdir}/tgci"
	rm -rf "${tmp}"; install -d "${tmp}"
	for n in 1 2 3 4; do
		bsdtar -xf "${srcdir}/tglayer${n}.tgz" -C "${tmp}" 2>/dev/null || true
	done

	install -Dm755 "${tmp}/usr/bin/tetragon" "${dir}/usr/local/bin/tetragon"
	install -Dm755 "${tmp}/usr/bin/tetra"    "${dir}/usr/local/bin/tetra"
	install -Dm755 "${tmp}/usr/bin/gops"     "${dir}/usr/local/lib/tetragon/gops"

	rm -f "${dir}/usr/local/lib/tetragon/bpf/"*.o
	install -d "${dir}/usr/local/lib/tetragon/bpf"
	install -m644 "${tmp}/var/lib/tetragon/"*.o "${dir}/usr/local/lib/tetragon/bpf/"

	# The reason the whole detour exists. If this is ever 4096 again the sensor
	# will not start on a 16K-page kernel, and it must not be discovered by a
	# user watching tetragon.service crash-loop.
	local probe="${dir}/usr/local/lib/tetragon/bpf/bpf_execve_map_update_v511.o"
	if [[ -f ${probe} ]] && ! grep -qa 'tg_rb_events' "${probe}"; then
		error 'the CI objects do not contain tg_rb_events; the layout changed'
		return 1
	fi

	msg2 "Tetragon: userspace and BPF from ${_tetragon_ci_ref}, bpftool from v${_tetragonver}"
}

prepare() {
	local repo="${startdir}/.."

	if [[ ! -f ${repo}/docs/CONTRACT.md || ! -f ${repo}/moatd/Cargo.toml ]]; then
		error 'run makepkg from the pkg/ directory of the omarchy-moat checkout'
		return 1
	fi

	if [[ ${CARCH} == aarch64 ]]; then
		_tetragon_from_ci || return 1
	fi

	# `shell` is NOT installed by package() -- the panel is a separate Omarchy
	# plugin, added with `omarchy plugin add` -- but it is copied here because
	# check() reads Service.qml. `privilegedCommands` in that file has to carry
	# every root-gated key the daemon defines, and when it does not the switch
	# still draws and still moves and comes back "needs root", which reads as a
	# permissions message rather than a bug. That went unnoticed for
	# `containers` until a second switch arrived the same way, so the check runs
	# in the build and not only in the repo.
	rm -rf "${srcdir:?}/${_tree}"
	install -d "${srcdir}/${_tree}"
	cp -a \
		"${repo}/moatd" \
		"${repo}/policies" \
		"${repo}/sandbox" \
		"${repo}/scanner" \
		"${repo}/docs" \
		"${repo}/skills" \
		"${repo}/assets" \
		"${repo}/README.md" \
		"${repo}/shell" \
		"${srcdir}/${_tree}/"

	# A developer's ./target would otherwise be reused (and its stale
	# artifacts shipped) inside the build.
	rm -rf "${srcdir}/${_tree}/moatd/target"

	# Vendor the crates now so build() can stay on --locked and the exact
	# Cargo.lock in the repository is what gets compiled.
	cd "${srcdir}/${_tree}/moatd"
	export RUSTUP_TOOLCHAIN=stable
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
	cd "${srcdir}/${_tree}/moatd"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	cargo build --release --locked
}

check() {
	cd "${srcdir}/${_tree}/moatd"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	cargo test --release --locked

	# Structural validation of the policy templates against the Tetragon
	# v1.7.1 grammar: a policy that would be rejected at daemon start is
	# caught here instead.
	cd "${srcdir}/${_tree}"
	python3 policies/check.py policies

	cd "${srcdir}/${_tree}/scanner"
	python3 -m unittest discover tests

	# Real bubblewrap, unprivileged, entirely inside a mktemp directory.
	# This works under makepkg because makepkg itself runs unprivileged;
	# only package() is fakeroot'd, and this is not package().
	cd "${srcdir}/${_tree}"
	bash sandbox/tests/run.sh
}

package() {
	local tetragon="${srcdir}/tetragon-v${_tetragonver}-${_tetarch}"
	local tree="${srcdir}/${_tree}"

	# --- upstream Tetragon, unmodified ---------------------------------
	# The tarball stages under /usr/local; Arch packages own /usr.
	install -Dm755 "${tetragon}/usr/local/bin/tetragon" "${pkgdir}/usr/bin/tetragon"
	install -Dm755 "${tetragon}/usr/local/bin/tetra"    "${pkgdir}/usr/bin/tetra"

	install -d "${pkgdir}/usr/lib/tetragon/bpf"
	install -m644 "${tetragon}/usr/local/lib/tetragon/bpf/"*.o "${pkgdir}/usr/lib/tetragon/bpf/"

	install -Dm755 "${tetragon}/usr/local/lib/tetragon/bpftool" "${pkgdir}/usr/lib/tetragon/bpftool"
	install -Dm755 "${tetragon}/usr/local/lib/tetragon/gops"    "${pkgdir}/usr/lib/tetragon/gops"

	# --- Tetragon configuration (ours, not upstream's) -----------------
	install -d "${pkgdir}/etc/tetragon/tetragon.conf.d"
	local f
	for f in "${_confd[@]}"; do
		if [[ ${f} == export-allowlist ]]; then
			# Regenerated byte for byte by `moatd render-policies`
			# on every tetragon.service start (Tetragon has no policy
			# hot-reload and policy_names has no glob). Shipped so the
			# export is already filtered on a first, pre-render start.
			install -m644 "${tree}/policies/export-allowlist.example" \
				"${pkgdir}/etc/tetragon/tetragon.conf.d/export-allowlist"
		else
			install -m644 "${tree}/policies/tetragon.conf.d/${f}" \
				"${pkgdir}/etc/tetragon/tetragon.conf.d/${f}"
		fi
	done

	# --- policy templates ({{HOME}} placeholders) ----------------------
	install -d "${pkgdir}/usr/lib/moat/policies"
	install -m644 "${tree}/policies/"*.yaml "${pkgdir}/usr/lib/moat/policies/"
	# The policy validator, installed rather than build-only: `moatd telemetry
	# --apply` re-runs it over what it just rendered and refuses to restart
	# the sensor if it fails. A profile switch is a policy load, and a bad
	# policy load is a silent 25-minute outage (docs/SHIPPING.md section 6).
	install -Dm755 "${tree}/policies/check.py" "${pkgdir}/usr/lib/moat/check.py"

	# --- systemd ------------------------------------------------------
	install -Dm644 "${tree}/policies/tetragon.service" \
		"${pkgdir}/usr/lib/systemd/system/tetragon.service"
	install -Dm644 "${tree}/moatd/systemd/moatd.service" \
		"${pkgdir}/usr/lib/systemd/system/moatd.service"
	install -Dm644 "${tree}/moatd/systemd/moat-feeds.service" \
		"${pkgdir}/usr/lib/systemd/system/moat-feeds.service"
	install -Dm644 "${tree}/moatd/systemd/moat-feeds.timer" \
		"${pkgdir}/usr/lib/systemd/system/moat-feeds.timer"
	# Not enabled by the .install: shipping anything off this machine is a
	# decision the admin makes, and ship.toml ships with enabled = false.
	install -Dm644 "${tree}/moatd/systemd/moat-ship.service" \
		"${pkgdir}/usr/lib/systemd/system/moat-ship.service"
	# The weekly digest (LEARNING section 5) is a *user* timer: desktop
	# notifications belong to the session bus, and `moatctl digest --notify`
	# needs no privilege. It is not enabled by the package; the .install
	# file tells the user the one command that enables it.
	install -Dm644 "${tree}/moatd/systemd/user/moat-digest.service" \
		"${pkgdir}/usr/lib/systemd/user/moat-digest.service"
	install -Dm644 "${tree}/moatd/systemd/user/moat-digest.timer" \
		"${pkgdir}/usr/lib/systemd/user/moat-digest.timer"
	install -Dm644 "${tree}/moatd/systemd/user/moat-triage.service" \
		"${pkgdir}/usr/lib/systemd/user/moat-triage.service"
	install -Dm644 "${tree}/moatd/systemd/user/moat-triage.timer" \
		"${pkgdir}/usr/lib/systemd/user/moat-triage.timer"
	install -Dm644 "${tree}/moatd/systemd/sysusers.d/moat.conf" \
		"${pkgdir}/usr/lib/sysusers.d/moat.conf"
	# /run/moat/policies (the rendered policies) comes from here, not
	# from the package: it lives on tmpfs. So does
	# /var/lib/moat/incidents (LEARNING section 4: the snapshots and the
	# bundle.md the AI analysis reads), 0750 root:moat so the panel and the
	# user's agent can read what the daemon wrote.
	install -Dm644 "${tree}/moatd/systemd/tmpfiles.d/moat.conf" \
		"${pkgdir}/usr/lib/tmpfiles.d/moat.conf"

	# --- our binaries -------------------------------------------------
	install -Dm755 "${tree}/moatd/target/release/moatd"      "${pkgdir}/usr/bin/moatd"
	install -Dm755 "${tree}/moatd/target/release/moatctl"    "${pkgdir}/usr/bin/moatctl"
	install -Dm755 "${tree}/moatd/target/release/moat-feeds" "${pkgdir}/usr/bin/moat-feeds"
	install -Dm755 "${tree}/moatd/target/release/moat-ship"  "${pkgdir}/usr/bin/moat-ship"
	install -Dm755 "${tree}/sandbox/moat-sandbox"          "${pkgdir}/usr/bin/moat-sandbox"
	install -Dm755 "${tree}/scanner/moat-scan-pkgbuild"    "${pkgdir}/usr/bin/moat-scan-pkgbuild"
	# The npm/pnpm/yarn/bun shims call this before an install runs; without it
	# on PATH they print "moat-scan-npm not found, skipping" on every install
	# and the pre-execution analysis silently does nothing.
	install -Dm755 "${tree}/scanner/moat-scan-npm"         "${pkgdir}/usr/bin/moat-scan-npm"
	# One implementation, three names: the cargo, pip/pip3/uv and go shims
	# each call the tool for their own ecosystem, argv[0] selects the rules
	# and the MOAT_SCANNER_* override in shim-common.sh is per ecosystem.
	# The infrastructure (finding shape, allow file, exit codes) and most of
	# the detection vocabulary are shared, so three files would have been
	# three copies of it.
	install -Dm755 "${tree}/scanner/moat-scan-build"       "${pkgdir}/usr/bin/moat-scan-build"
	local _alias
	for _alias in cargo pip go; do
		ln -sf moat-scan-build "${pkgdir}/usr/bin/moat-scan-${_alias}"
	done

	# --- sandbox shims ------------------------------------------------
	install -d "${pkgdir}/usr/lib/moat/shims"
	# Sourced, never executed.
	install -m644 "${tree}/sandbox/shims/shim-common.sh" "${pkgdir}/usr/lib/moat/shims/shim-common.sh"
	local shim
	for shim in npm npx pnpm yarn bun pip pip3 uv cargo go makepkg; do
		install -m755 "${tree}/sandbox/shims/${shim}" "${pkgdir}/usr/lib/moat/shims/${shim}"
	done

	# Both snippets are no-ops unless /etc/moat/sandbox.enabled exists,
	# which `moatctl set sandbox on` creates.
	install -Dm644 "${tree}/sandbox/profile.d/moat-shims.sh" \
		"${pkgdir}/etc/profile.d/moat-shims.sh"
	install -Dm644 "${tree}/sandbox/fish/conf.d/moat-shims.fish" \
		"${pkgdir}/usr/share/fish/vendor_conf.d/moat-shims.fish"

	# --- configuration ------------------------------------------------
	install -Dm644 "${tree}/moatd/etc/moat.toml" "${pkgdir}/etc/moat/moat.toml"
	# feeds.toml carries no credential any more -- the package index is keyless
	# and signed -- but it does carry the base_url and the pinned key path, so
	# it stays root-only.
	install -Dm600 "${tree}/moatd/etc/feeds.toml"    "${pkgdir}/etc/moat/feeds.toml"

	# The pinned feed verification key, world-readable because it is public and
	# moat-feeds may run as any user that can read the config.
	#
	# Conditional on purpose: until the aggregator is deployed there is no
	# keypair, and a hard failure here would mean moat could not be built at all
	# before its feed exists. The consequence of it being absent is already the
	# right one -- `require_signature = true` makes moat-feeds refuse every
	# artifact and say so -- so an inert feed is the failure mode, not a broken
	# package. Once secrets/ holds a key, copy the .pub to moatd/etc/ and commit
	# it; the private half never leaves the aggregator.
	if [[ -f ${tree}/moatd/etc/feed-key.pub ]]; then
		install -Dm644 "${tree}/moatd/etc/feed-key.pub" "${pkgdir}/usr/share/moat/feed-key.pub"
	else
		echo "==> NOTE: no moatd/etc/feed-key.pub; the package feed will be inert" >&2
	fi
	install -Dm644 "${tree}/moatd/etc/allowlist.d/default.toml" \
		"${pkgdir}/etc/moat/allowlist.d/default.toml"
	# The shipped baseline (LEARNING section 8): reviewed once by a human,
	# every entry carrying a comment saying which actor, which rule and why
	# it is benign. baseline.toml, the *learned* file next to it, is runtime
	# state written by the daemon and is deliberately NOT shipped.
	install -Dm644 "${tree}/moatd/etc/allowlist.d/omarchy-default.toml" \
		"${pkgdir}/etc/moat/allowlist.d/omarchy-default.toml"
	# Moat's own test-suite entries, shipped as an EXAMPLE and not loaded.
	# `.example` is not `.toml`, so the loader ignores it. They were in
	# default.toml until 2026-09-08, where they were a production grant keyed
	# on source-tree naming -- anyone able to create a directory shaped like a
	# moat checkout inherited an exec exclusion. Only people who build moat
	# from source ever wanted them.
	install -Dm644 "${tree}/moatd/etc/allowlist.d/moat-dev.toml.example" \
		"${pkgdir}/usr/share/doc/omarchy-moat/moat-dev.toml.example"
	# ship.toml holds no secret as shipped, which is why it is 0644 and
	# readable: the header TEMPLATE is diffable, the token lives in its own
	# 0600 file. An inline token makes moat-ship refuse to start until this
	# file is 0600.
	install -Dm644 "${tree}/moatd/etc/ship.toml"         "${pkgdir}/etc/moat/ship.toml"
	install -Dm644 "${tree}/sandbox/sandbox.conf"        "${pkgdir}/etc/moat/sandbox.conf"
	install -Dm644 "${srcdir}/scanner-allow.conf"        "${pkgdir}/etc/moat/scanner-allow.conf"

	# --- licenses -----------------------------------------------------
	install -Dm644 "${srcdir}/LICENSE.MIT" \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -Dm644 "${srcdir}/tetragon-${_tetragonver}-LICENSE" \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.tetragon"
	install -Dm644 "${srcdir}/tetragon-${_tetragonver}-LICENSE.bpf" \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.tetragon-bpf"

	# --- documentation ------------------------------------------------
	# moatd.service points its Documentation= at README.md here.
	install -Dm644 "${tree}/README.md"           "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	install -Dm644 "${tree}/moatd/README.md" "${pkgdir}/usr/share/doc/${pkgname}/moatd.md"
	install -Dm644 "${tree}/policies/README.md"  "${pkgdir}/usr/share/doc/${pkgname}/policies.md"
	install -Dm644 "${tree}/sandbox/README.md"   "${pkgdir}/usr/share/doc/${pkgname}/sandbox.md"
	install -Dm644 "${tree}/scanner/README.md"   "${pkgdir}/usr/share/doc/${pkgname}/scanner.md"
	install -Dm644 "${tree}/docs/CONTRACT.md"    "${pkgdir}/usr/share/doc/${pkgname}/CONTRACT.md"
	install -Dm644 "${tree}/docs/TETRAGON-NOTES.md" \
		"${pkgdir}/usr/share/doc/${pkgname}/TETRAGON-NOTES.md"
	# /etc/moat/moat.toml's own comments cite these two by section number
	# ([baseline], [learning], [analysis], [incidents], [digest]), so a user
	# reading the config needs them on disk.
	install -Dm644 "${tree}/docs/BASELINE.md" \
		"${pkgdir}/usr/share/doc/${pkgname}/BASELINE.md"
	install -Dm644 "${tree}/docs/LEARNING-AND-ANALYSIS.md" \
		"${pkgdir}/usr/share/doc/${pkgname}/LEARNING-AND-ANALYSIS.md"
	# moat-ship.service's Documentation= points here, and /etc/moat/ship.toml
	# and the [telemetry] block of moat.toml both cite it by section.
	install -Dm644 "${tree}/docs/SHIPPING.md" \
		"${pkgdir}/usr/share/doc/${pkgname}/SHIPPING.md"
	install -Dm644 "${tree}/docs/CLI.md" \
		"${pkgdir}/usr/share/doc/${pkgname}/CLI.md"

	# --- the agent skill ----------------------------------------------
	# Omarchy's own convention: every directory under
	# /usr/share/omarchy/default/agents/skills is a skill, and Omarchy links
	# them into each agent's skill directory (~/.claude/skills,
	# ~/.gemini/config/skills). We install into that directory rather than
	# into a private /usr/share/omarchy-moat/skills, because a skill nothing
	# links is a skill nobody loads -- and the linking convention is
	# Omarchy's, not ours to reinvent.
	#
	# The directory is not owned by the omarchy package (pacman only
	# conflicts on identical file paths), and the name is namespaced, so
	# this cannot collide with a skill Omarchy ships.
	#
	# Omarchy links these from a one-shot migration, so an already-installed
	# machine will not pick this up on its own; omarchy-moat.install prints
	# the single `ln -s` for that case, the same way it prints the one
	# command that enables the digest timer.
	local _skills="${pkgdir}/usr/share/omarchy/default/agents/skills/moat-tuning"
	install -Dm644 "${tree}/skills/moat-tuning/SKILL.md" "${_skills}/SKILL.md"
	install -d "${_skills}/references"
	install -m644 "${tree}/skills/moat-tuning/references/"*.md "${_skills}/references/"

	# The mark, in the hicolor set, so anything that shows an icon for this
	# package (a .desktop entry, a notification, a tray) finds one by name
	# rather than falling back to a generic cog. Scalable plus the two raster
	# sizes a 16px tray actually uses -- the handoff is explicit that 16 is a
	# separate drawing, never a downscale of 32.
	install -Dm644 "${tree}/assets/svg/mark-accent.svg" \
		"${pkgdir}/usr/share/icons/hicolor/scalable/apps/omarchy-moat.svg"
	for _px in 16 24 32 64 128 256; do
		install -Dm644 "${tree}/assets/png/mark-${_px}.png" \
			"${pkgdir}/usr/share/icons/hicolor/${_px}x${_px}/apps/omarchy-moat.png"
	done
}
