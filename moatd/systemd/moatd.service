[Unit]
Description=Moat alert daemon (Tetragon event enrichment and control socket)
Documentation=file:///usr/share/doc/omarchy-moat/README.md
# Tetragon is the sensor; without it there is no export file to tail. Requires=
# (not Wants=) because a running moatd with no sensor is a lie: the shield
# in the bar would be green while nothing is watched.
Requires=tetragon.service
After=tetragon.service
PartOf=tetragon.service

# Never give up restarting; see the same note in tetragon.service.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/moatd run
# SIGHUP re-reads moat.toml, the rendered policies' annotations and
# allowlist.d without dropping the process table.
ExecReload=/bin/kill -HUP $MAINPID
# `always`, not `on-failure`. `on-failure` leaves the daemon down after a clean
# exit(0), and "the security daemon exited successfully and stayed off" is not a
# state anything should be able to reach on purpose.
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=15s

# /run/moat, 0750 root:moat — the control socket lives here and the
# group needs +x on the directory to reach it.
RuntimeDirectory=moat
RuntimeDirectoryMode=0750
# yes: /run/moat also holds the policies rendered for tetragon.service; a
# moatd restart must not delete them. tmpfiles.d creates the dir at boot.
RuntimeDirectoryPreserve=yes

# Only these four trees are writable; everything else, /usr included, is
# read-only to this unit.
ProtectSystem=strict
# The last four are moat's own state. The rest is the ONLY reason quarantine
# can do anything: under ProtectSystem=strict every other path is read-only, so
# `moatctl quarantine` copied the file and then failed with EROFS trying to
# remove the original -- it reported a quarantine and left the implant running.
# $HOME matters most: this threat model is a hijacked package running as the
# user, and it drops its payload there, not in /tmp.
#
# This is a real widening of a root daemon's reach, so the removal path is
# written to deserve it: control.rs copies from a descriptor opened O_NOFOLLOW
# and removes with unlinkat() relative to the parent directory, which cannot be
# redirected out of that directory by swapping a symlink in.
ReadWritePaths=/var/lib/moat /var/log/moat /run/moat /etc/moat /tmp /var/tmp /dev/shm /home

# Capabilities, and why each one is here:
#   CAP_KILL             `moatctl kill` signals a process of any uid
#   CAP_DAC_READ_SEARCH  read $HOME dotfiles to sha256 an executed binary
#   CAP_DAC_OVERRIDE     move a quarantined file out of a directory we do not own
#   CAP_CHOWN            chown alerts.jsonl and the socket to root:moat
#   CAP_FOWNER           chmod 000 a quarantined file we do not own
#   CAP_SYS_PTRACE       read /proc/<pid>/{exe,environ,fd} of another uid: to verify
#                        a kill target, and to take the incident snapshot of the
#                        process before it is killed (LEARNING §4)
CapabilityBoundingSet=CAP_KILL CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_SYS_PTRACE
AmbientCapabilities=CAP_KILL CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_SYS_PTRACE
NoNewPrivileges=yes

# ReadWritePaths=/home above takes precedence over this for /home itself;
# this still keeps /root and /run/user read-only.
ProtectHome=read-only
PrivateTmp=no
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=default
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service @signal
SystemCallErrorNumber=EPERM
UMask=0027

[Install]
WantedBy=multi-user.target
