[Unit]
Description=Refresh the Moat malicious-package index
Documentation=file:///usr/share/doc/moat/PACKAGE-FEED.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/moat-feeds
# Never fails hard: any error leaves the previous index in place and exits 0,
# because a stale feed is not a broken feed (CONTRACT 6.7). The one loud case
# is a signature that does not verify.
SuccessExitStatus=0
User=root
# feeds.toml carries no credential any more -- the index is keyless and
# signed -- but read-only is still all this needs.
ProtectSystem=strict
ReadWritePaths=/var/lib/moat/feeds
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
CapabilityBoundingSet=
