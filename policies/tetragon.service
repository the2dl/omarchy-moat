# omarchy-moat: hardened unit for the upstream Tetragon v1.7.1 daemon.
# Derived from the unit shipped in tetragon-v1.7.1-amd64.tar.gz
# (usr/lib/systemd/system/tetragon.service, Apache-2.0, Authors of Tetragon).
# Changes: FHS paths from CONTRACT.md section 2, policy rendering as
# ExecStartPre, and sandboxing that does not take away what eBPF needs.

[Unit]
Description=Tetragon eBPF sensor for omarchy-moat
Documentation=https://tetragon.io/
DefaultDependencies=no
After=local-fs.target
Before=shutdown.target
Conflicts=shutdown.target
# Never stop trying.
#
# This used to give up after 10 attempts in 2 minutes, which on a security
# sensor is a switch anyone who can crash it ten times gets to flip: the sensor
# stays down until a human runs `systemctl reset-failed`, and nothing says so.
# A crash loop is noisy and visible; a sensor that quietly decided to stop is
# neither. `StartLimitIntervalSec=0` disables the limit entirely.
StartLimitIntervalSec=0

[Service]
Type=simple
Environment="PATH=/usr/lib/tetragon:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
User=root
Group=root

# Render policies/*.yaml ({{HOME}} -> one value per human user home) into
# /run/moat/policies and regenerate the export-allowlist conf.d file.
# Tetragon reads --tracing-policy-dir once at startup and has no hot reload,
# so this must run before every start.
ExecStartPre=/usr/bin/moatd render-policies
ExecStart=/usr/bin/tetragon

# Make "started" mean "the policies are loaded".
#
# `Type=simple` calls this unit started the instant /usr/bin/tetragon forks. On
# 2026-09-05 that was 16 seconds and 44 policies too early: moatd is
# `After=tetragon.service` and re-armed its policies 2 s after start, so all
# seven `tetra tp set-mode` calls failed against names the kernel did not have
# yet -- once with `dial tcp [::1]:54321: address family not supported`, then
# six times with `tracing policy {moat-...} does not exist`. Nothing retried,
# and `moatctl status` and the panel went on listing all seven as enforcing.
#
# A unit with an ExecStartPost stays in `activating` until that command
# returns, so this is what finally makes `After=tetragon.service` order against
# a LOADED sensor. It counts the policies pinned under /sys/fs/bpf/tetragon,
# which is the same signal `moatctl status` trusts.
#
# The `-` prefix is deliberate. A slow load must not fail this unit and hand it
# to `Restart=always` in a loop -- the ordering is the point, and the exit code
# is for a human running `moatd wait-sensor` by hand. moatd waits for the
# sensor on its own account too ([thresholds] arm_wait_secs): this fixes the
# boot order, and only the boot order, while a tetragon that reloads policies
# later needs the daemon-side wait.
ExecStartPost=-/usr/bin/moatd wait-sensor --timeout 120

# `always`, not `on-failure`: a clean exit(0) must bring it back too. Only an
# explicit `systemctl stop` should keep it down.
Restart=always
RestartSec=5
# Must exceed the ExecStartPost wait above (120 s) plus the render, or systemd
# would kill a sensor that is loading normally and `Restart=always` would do it
# again. 16 s is the observed load time for 44 policies; this is the ceiling for
# a cold boot on a slow disk, not the expected case.
TimeoutStartSec=180
TimeoutStopSec=30
KillMode=mixed
OOMScoreAdjust=-500

# /run/tetragon holds the gRPC socket (server-address in tetragon.conf.d).
# /run/moat and /var/log/moat come from the package's tmpfiles.d.
RuntimeDirectory=tetragon
RuntimeDirectoryMode=0750

# BPF maps are accounted against locked memory on some configurations.
LimitMEMLOCK=infinity
LimitNOFILE=1048576

# --- sandboxing -------------------------------------------------------------
# Everything below was chosen so that BPF program loading, bpffs pinning,
# /proc scanning and kallsyms lookups keep working. Do not add
# ProtectKernelTunables=yes (it remounts /sys read-only and breaks pinning)
# or PrivateMounts/PrivateUsers (they break process and path visibility).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/moat /var/log/moat /var/lib/moat /sys/fs/bpf /etc/tetragon/tetragon.conf.d
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=no
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_NET_ADMIN CAP_SYSLOG CAP_IPC_LOCK CAP_CHOWN CAP_FOWNER CAP_KILL

[Install]
WantedBy=multi-user.target
