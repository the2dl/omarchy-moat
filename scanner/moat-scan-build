# main
# --------------------------------------------------------------------------


def main(argv: list[str] | None = None) -> int:
    # Installed under three names; argv[0] picks the ecosystem so each shim
    # calls the tool for its own, and `--for` overrides.
    invoked = os.path.basename(sys.argv[0]) if sys.argv and sys.argv[0] else ""
    prog = invoked if invoked in PROG_ECOSYSTEM else "moat-scan-build"
    default_eco = PROG_ECOSYSTEM.get(prog, "")

    ap = argparse.ArgumentParser(
        prog=prog,
        description="Static review of a Rust, Python or Go project before its "
                    "build and install steps run.",
    )
    ap.add_argument("paths", metavar="PATH", nargs="*", default=None,
                    help="project directories or single files (default: .)")
    ap.add_argument("--for", dest="ecosystems", action="append", default=[],
                    choices=ECOSYSTEMS, metavar="ECOSYSTEM",
                    help="scan only this ecosystem (%s); repeatable. Default: "
                         "whichever ones this directory has"
                         % ", ".join(ECOSYSTEMS))
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--min-severity", choices=(SEV_LOW, SEV_MEDIUM, SEV_HIGH),
                    default=SEV_LOW, help="drop findings below this severity")
    ap.add_argument("--quiet", "-q", action="store_true",
                    help="print nothing; use the exit code (JSON still prints "
                         "with --json)")
    ap.add_argument("--deep", action="store_true",
                    help="also run the build-code rules over every source file "
                         "in the tree, not just the ones that run at build time")
    ap.add_argument("--max-per-rule", type=int, default=10, metavar="N",
                    help="human output only: show at most N findings per rule "
                         "(0 = no limit)")
    ap.add_argument("--no-color", action="store_true", help="never colorize")
    ap.add_argument("--allow-file", metavar="PATH", action="append", default=[],
                    help="extra allow file (in addition to %s and %s)"
                         % (ALLOW_SYSTEM, ALLOW_USER))
    ap.add_argument("--no-allow", action="store_true", help="ignore all allow files")
    ap.add_argument("--version", action="version", version=prog + " " + VERSION)
    args = ap.parse_args(argv)

    ecosystems = args.ecosystems or ([default_eco] if default_eco else [])
    paths = args.paths or ["."]
    warnings: list[str] = []
    findings = scan_paths(paths, ecosystems, deep=args.deep, warn=warnings.append)

    allow = [] if args.no_allow else load_allow(allow_file_paths(args.allow_file))
    if allow:
        kept = [f for f in findings if not is_allowed(f, allow)]
        suppressed = len(findings) - len(kept)
        findings = kept
    else:
        suppressed = 0

    floor = SEV_RANK[args.min_severity]
    findings = [f for f in findings if SEV_RANK[f.severity] >= floor]
    counts = summarize(findings)

    if args.json:
        json.dump(
            {"findings": [f.as_dict() for f in findings],
             "summary": {"high": counts[SEV_HIGH], "medium": counts[SEV_MEDIUM],
                         "low": counts[SEV_LOW]}},
            sys.stdout,
            indent=2,
        )
        sys.stdout.write("\n")
    elif not args.quiet:
        color = (not args.no_color) and sys.stdout.isatty() and not os.environ.get("NO_COLOR")
        bypass = BYPASS_COMMAND.get(ecosystems[0] if len(ecosystems) == 1 else "",
                                    BYPASS_COMMAND[""])
        render_table(findings, color, sys.stdout, suppressed, args.max_per_rule,
                     bypass)

    if not args.quiet:
        for w in warnings:
            sys.stderr.write("%s: %s\n" % (prog, w))

    if counts[SEV_HIGH]:
        return 2
    if counts[SEV_MEDIUM]:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
