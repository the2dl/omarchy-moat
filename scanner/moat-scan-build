# PEP 517 backends that ship in wheels of their own; a backend-path is only
# interesting when it points into the package being installed.
STANDARD_BACKENDS = (
    "setuptools.build_meta", "setuptools.build_meta:__legacy__",
    "flit_core.buildapi", "hatchling.build", "poetry.core.masonry.api",
    "pdm.backend", "maturin", "scikit_build_core.build", "mesonpy",
)

# A .pth line that starts with `import ` is exec'd by site.py on every
# interpreter start.  These two are the idioms that legitimately do it.
PTH_BENIGN_RE = re.compile(
    r"^import\s+__editable___"
    r"|^import\s+_distutils_hack\b"
    r"|^import\s+os;\s*var\s*=\s*'SETUPTOOLS_USE_DISTUTILS'"
    r"|^import\s+sys;\s*sys\.__plen\b"
    r"|^import\s+sys,\s*types,\s*os;"
)

PIP_INDEX_KEYS = ("index-url", "extra-index-url", "find-links", "trusted-host",
                  "index_url", "extra_index_url", "find_links", "trusted_host")

REQ_OPTION_RE = re.compile(
    r"^\s*(--index-url|-i|--extra-index-url|--find-links|-f|--trusted-host)"
    r"[=\s]+(\S+)"
)
REQ_DIRECT_RE = re.compile(
    r"(?:^|\s|@\s*)((?:git|hg|svn|bzr)\+\S+|https?://\S+)"
)


def python_project_name(root: str) -> str:
    for fn, pat in (
        ("pyproject.toml", r'^\s*name\s*=\s*["\']([^"\']+)'),
        ("setup.cfg", r"^\s*name\s*=\s*(\S+)"),
    ):
        text = read_text(os.path.join(root, fn))
        if not text:
            continue
        m = re.search(pat, text, re.M)
        if m:
            return m.group(1)
    text = read_text(os.path.join(root, "setup.py"))
    if text:
        m = re.search(r"""\bname\s*=\s*["']([^"']+)""", text)
        if m:
            return m.group(1)
    return os.path.basename(os.path.abspath(root))


def scan_setup_py(sc: Scanner, path: str, display: str, pkg: str) -> None:
    text = read_text(path)
    if text is None:
        return
    scan_build_code(sc, text, display, pkg,
                    net_rule="exec.setup-py-network", net_re=PY_NET_RE)
    for m in re.finditer(r"\bsetup_requires\s*=", text):
        sc.add("py.setup-requires", display, line_at(text, m.start()),
               text.splitlines()[line_at(text, m.start()) - 1], pkg=pkg)


def scan_pyproject(sc: Scanner, path: str, display: str, root: str,
                   pkg: str) -> None:
    text = read_text(path)
    if text is None:
        return
    scan_unicode(sc, text, display, pkg)
    here = os.path.dirname(os.path.abspath(path))
    backend = ""
    for e in toml_entries(text):
        if e.section == "build-system" and e.key == "build-backend":
            backend = toml_str(e.value)

        if e.section == "build-system" and e.key == "backend-path":
            paths = toml_array(e.value) or [toml_str(e.value)]
            outside = [p for p in paths if p and escapes(here, p)]
            sc.add("py.build-backend-path", display, e.line, e.raw.strip(),
                   severity=SEV_HIGH if outside else SEV_MEDIUM,
                   why=("backend-path points outside the package (%s), so pip "
                        "imports and runs code from somewhere else entirely"
                        % ", ".join(outside)) if outside else None,
                   pkg=pkg)
            for p in paths:
                if not p or escapes(here, p):
                    continue
                mod = backend.split(":", 1)[0].split(".", 1)[0]
                for cand in (mod + ".py", os.path.join(mod, "__init__.py")):
                    full = os.path.join(here, p, cand)
                    if os.path.isfile(full):
                        body = read_text(full)
                        if body is not None:
                            scan_build_code(sc, body,
                                            rel_display(root, display, full), pkg,
                                            net_rule="exec.setup-py-network",
                                            net_re=PY_NET_RE)

        if e.section == "build-system" and e.key == "requires":
            for req in toml_array(e.value):
                m = REQ_DIRECT_RE.search(req)
                if not m:
                    continue
                url = m.group(1)
                if check_url(sc, url, display, e.line, req, pkg=pkg):
                    continue
                sc.add("py.direct-url-requirement", display, e.line,
                       "[build-system] requires: %s" % req,
                       why="a build requirement is fetched from a URL and its "
                           "setup.py runs before anything else pip does",
                       pkg=pkg, host=url_host(url))

        # Index overrides in the tool tables uv, poetry and pdm read.
        if e.key in ("url", "index-url", "extra-index-url", "default-index") and (
            e.section.startswith("tool.uv")
            or e.section.startswith("tool.poetry.source")
            or e.section.startswith("tool.pdm")
            or e.section.startswith("tool.rye")
        ):
            url = toml_str(e.value)
            if not url:
                continue
            host = url_host(url)
            if check_url(sc, url, display, e.line, e.raw.strip(), pkg=pkg):
                continue
            if host in PYPI_HOSTS:
                continue
            sc.add("py.index-override", display, e.line,
                   "[%s] %s" % (e.section, e.raw.strip()), pkg=pkg, host=host)


def scan_requirements(sc: Scanner, path: str, display: str, pkg: str) -> None:
    text = read_text(path)
    if text is None:
        return
    scan_unicode(sc, text, display, pkg)
    for no, raw in enumerate(text.splitlines(), start=1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        m = REQ_OPTION_RE.match(line)
        if m:
            opt, val = m.group(1), m.group(2)
            host = url_host(val) or val
            if check_url(sc, val, display, no, raw, pkg=pkg):
                continue
            if host in PYPI_HOSTS and opt in ("--index-url", "-i"):
                continue
            # --index-url and --find-links replace the index outright: a
            # deliberate, visible choice with no name shadowing, and the
            # single most common line in a real requirements file
            # (download.pytorch.org appears eight times on this machine).
            # --extra-index-url is the one that shadows PyPI names.
            sev = SEV_LOW
            why = None
            if opt == "--trusted-host":
                sev = SEV_MEDIUM
                why = ("--trusted-host turns off certificate verification for %s, "
                       "so anything on the path can serve the packages" % host)
            elif opt == "--extra-index-url":
                sev = SEV_MEDIUM
                why = ("--extra-index-url adds %s alongside PyPI, and pip installs "
                       "whichever index has the higher version: the "
                       "dependency-confusion shape" % host)
            else:
                why = ("this file makes pip resolve every name against %s "
                       "instead of PyPI" % host)
            sc.add("py.index-override", display, no, raw, severity=sev, why=why,
                   pkg=pkg, host=host)
            continue
        m = REQ_DIRECT_RE.search(line)
        if not m:
            continue
        url = m.group(1)
        if check_url(sc, url, display, no, raw, pkg=pkg):
            continue
        host = url_host(url)
        sev = SEV_LOW if is_known_forge(host) else SEV_MEDIUM
        sc.add("py.direct-url-requirement", display, no, raw, severity=sev,
               pkg=pkg, host=host)


def scan_pip_conf(sc: Scanner, path: str, display: str, pkg: str) -> None:
    text = read_text(path)
    if text is None:
        return
    for no, raw in enumerate(text.splitlines(), start=1):
        line = raw.split("#", 1)[0].split(";", 1)[0].strip()
        if "=" not in line:
            continue
        key, _, val = line.partition("=")
        if key.strip().lower() not in PIP_INDEX_KEYS:
            continue
        val = val.strip()
        if check_url(sc, val, display, no, raw, pkg=pkg):
            continue
        host = url_host(val) or val
        if host in PYPI_HOSTS:
            continue
        sc.add("py.index-override", display, no, raw, pkg=pkg, host=host)


def scan_pth(sc: Scanner, path: str, display: str, pkg: str) -> None:
    text = read_text(path, cap=1024 * 1024)
    if text is None:
        return
    scan_unicode(sc, text, display, pkg)
    for no, raw in enumerate(text.splitlines(), start=1):
        # site.py: a line beginning "import " or "import\t" is exec'd.
        if not (raw.startswith("import ") or raw.startswith("import\t")):
            continue
        sev = SEV_MEDIUM
        why = None
        if PTH_BENIGN_RE.match(raw.strip()):
            sev = SEV_LOW
            why = ("an editable-install or setuptools shim line; it runs on every "
                   "interpreter start, which is expected for these two")
        elif (PY_NET_RE.search(raw) or CREDENTIAL_RE.search(raw)
              or has_decoder(raw) or SHELL_PIPE_RE.search(raw)
              or re.search(r"\b(?:exec|eval|__import__|subprocess|os\.system)\s*\(", raw)):
            sev = SEV_HIGH
            why = ("this line is exec'd by site.py on every interpreter start and "
                   "it fetches, decodes or spawns; that is persistence, not a build")
        sc.add("py.startup-hook", display, no, raw, severity=sev, why=why, pkg=pkg)
        for m in URL_RE.finditer(raw):
            check_url(sc, m.group(0), display, no, raw, pkg=pkg)


def scan_python(sc: Scanner, root: str, display: str, deep: bool, warn) -> None:
    pkg = python_project_name(root)

    setup_py = os.path.join(root, "setup.py")
    if os.path.isfile(setup_py):
        scan_setup_py(sc, setup_py, rel_display(root, display, setup_py), pkg)

    pyproject = os.path.join(root, "pyproject.toml")
    if os.path.isfile(pyproject):
        scan_pyproject(sc, pyproject, rel_display(root, display, pyproject),
                       root, pkg)

    setup_cfg = os.path.join(root, "setup.cfg")
    text = read_text(setup_cfg)
    if text:
        for m in re.finditer(r"^\s*setup_requires\s*=", text, re.M):
            sc.add("py.setup-requires", rel_display(root, display, setup_cfg),
                   line_at(text, m.start()),
                   text.splitlines()[line_at(text, m.start()) - 1], pkg=pkg)

    # sitecustomize/usercustomize run on every interpreter start, exactly like
    # a .pth import line, and land in site-packages the same way.
    for fn in ("sitecustomize.py", "usercustomize.py"):
        full = os.path.join(root, fn)
        if not os.path.isfile(full):
            continue
        d = rel_display(root, display, full)
        sc.add("py.startup-hook", d, 1, "%s runs on every interpreter start" % fn,
               pkg=pkg)
        body = read_text(full)
        if body is not None:
            scan_build_code(sc, body, d, pkg, net_rule="exec.setup-py-network",
                            net_re=PY_NET_RE)

    try:
        top_level = sorted(os.listdir(root))
    except OSError:
        top_level = []
    for fn in top_level:
        full = os.path.join(root, fn)
        if not os.path.isfile(full):
            continue
        low = fn.lower()
        if low.startswith("requirements") and low.endswith((".txt", ".in")):
            scan_requirements(sc, full, rel_display(root, display, full), pkg)
        elif low in ("pip.conf", "pip.ini", "constraints.txt"):
            scan_pip_conf(sc, full, rel_display(root, display, full), pkg)

    for sub in (".pip", "pip"):
        for fn in ("pip.conf", "pip.ini"):
            full = os.path.join(root, sub, fn)
            if os.path.isfile(full):
                scan_pip_conf(sc, full, rel_display(root, display, full), pkg)

    seen = 0
    for dirpath, dirnames, filenames in walk(root):
        for fn in filenames:
            if not fn.endswith(".pth") or seen >= MAX_PTH_FILES:
                continue
            seen += 1
            full = os.path.join(dirpath, fn)
            scan_pth(sc, full, rel_display(root, display, full), pkg)

    if deep:
        deep_walk(sc, root, display, warn, pkg, (".py",), PY_NET_RE,
                  "exec.setup-py-network")


# ==========================================================================
# go
# ==========================================================================

GO_GENERATE_RE = re.compile(r"^//go:generate\s+(.+?)\s*$", re.M)
GO_LINKNAME_RE = re.compile(r"^//go:linkname\s+(.+?)\s*$", re.M)
GO_REPLACE_RE = re.compile(
    r"^\s*(?:replace\s+)?(\S+)(?:\s+(v\S+))?\s*=>\s*(\S+)(?:\s+(v\S+))?\s*$"
)

# Heads that make a go:generate directive ordinary code generation.
GO_GENERATE_BENIGN_RE = re.compile(
    r"^(?:go|gofmt|goimports|stringer|mockgen|moq|counterfeiter|protoc[\w-]*|"
    r"swag|enumer|easyjson|msgp|deepcopy-gen|client-gen|informer-gen|"
    r"lister-gen|conversion-gen|defaulter-gen|controller-gen|wire|sqlc|"
    r"oapi-codegen|go-bindata|statik|esc|gotext|mvdan\.cc/\S+|"
    r"golang\.org/x/\S+|github\.com/\S+)\b"
)

GO_SHELL_HEAD_RE = re.compile(
    r"^(?:/(?:usr/)?bin/)?(?:ba|z|k|da|a)?sh\s+-c\b"
    r"|^(?:python3?|perl|ruby|node)\s+-[ce]\b"
    r"|^(?:curl|wget|aria2c|nc|ncat|socat)\b"
    r"|^env\s+\S+=\S+\s+(?:sh|bash)\b"
)


def scan_go_mod(sc: Scanner, path: str, display: str) -> str:
    text = read_text(path)
    if text is None:
        return ""
    scan_unicode(sc, text, display)
    here = os.path.dirname(os.path.abspath(path))
    m = re.search(r"^\s*module\s+(\S+)", text, re.M)
    module = m.group(1) if m else os.path.basename(here)

    in_block = False
    for no, raw in enumerate(text.splitlines(), start=1):
        line = raw.split("//", 1)[0].strip()
        if not line:
            continue
        if line.startswith("replace") and line.endswith("("):
            in_block = True
            continue
        if in_block and line == ")":
            in_block = False
            continue
        if not (in_block or line.startswith("replace")):
            continue
        rm = GO_REPLACE_RE.match(line)
        if not rm:
            continue
        target = rm.group(3)
        if target.startswith(".") or target.startswith("/"):
            if escapes(here, target):
                sc.add("go.replace-outside-tree", display, no, raw, pkg=module)
        elif "://" in target:
            check_url(sc, target, display, no, raw, pkg=module)
    return module


def scan_go_source(sc: Scanner, text: str, display: str, pkg: str) -> None:
    for m in GO_GENERATE_RE.finditer(text):
        cmd = m.group(1).strip()
        no = line_at(text, m.start())
        sev = SEV_LOW
        why = None
        if SHELL_PIPE_RE.search(cmd):
            sc.add("net.curl-pipe-shell", display, no, "//go:generate " + cmd,
                   pkg=pkg)
            continue
        hostile = False
        for um in URL_RE.finditer(cmd):
            hostile = check_url(sc, um.group(0), display, no,
                                "//go:generate " + cmd, pkg=pkg) or hostile
        if hostile:
            continue
        if CREDENTIAL_RE.search(cmd):
            sc.add("cred.build-read", display, no, "//go:generate " + cmd, pkg=pkg)
            continue
        if GO_SHELL_HEAD_RE.match(cmd):
            sev = SEV_MEDIUM
            why = ("the directive hands a command line to a shell or an "
                   "interpreter, so what it runs is not visible in the source")
        elif GO_GENERATE_BENIGN_RE.match(cmd):
            continue
        sc.add("go.generate-directive", display, no, "//go:generate " + cmd,
               severity=sev, why=why, pkg=pkg)

    for m in GO_LINKNAME_RE.finditer(text):
        sc.add("go.linkname", display, line_at(text, m.start()),
               "//go:linkname " + m.group(1), pkg=pkg)


def scan_go(sc: Scanner, root: str, display: str, deep: bool, warn) -> None:
    module = ""
    gomod = os.path.join(root, "go.mod")
    if os.path.isfile(gomod):
        module = scan_go_mod(sc, gomod, rel_display(root, display, gomod))
    pkg = module or os.path.basename(os.path.abspath(root))

    seen = 0
    stop = False
    for dirpath, dirnames, filenames in walk(root):
        if stop:
            break
        for fn in filenames:
            full = os.path.join(dirpath, fn)
            # A nested go.mod is a separate module with its own replaces.
            if fn == "go.mod" and full != gomod:
                scan_go_mod(sc, full, rel_display(root, display, full))
                continue
            if not fn.endswith(".go"):
                continue
            seen += 1
            if seen > MAX_GO_FILES:
                warn("stopped after %d Go files; re-run on a smaller path"
                     % MAX_GO_FILES)
                stop = True
                break
            text = read_text(full)
            if text is None:
                continue
            d = rel_display(root, display, full)
            scan_go_source(sc, text, d, pkg)
            if deep:
                scan_build_code(sc, text, d, pkg, net_rule="", net_re=None)


# ==========================================================================
# dispatch
# ==========================================================================


def deep_walk(sc: Scanner, root: str, display: str, warn, pkg: str,
              exts: tuple[str, ...], net_re, net_rule: str) -> None:
    seen = 0
    for dirpath, dirnames, filenames in walk(root):
        for fn in filenames:
            if not fn.endswith(exts):
                continue
            seen += 1
            if seen > MAX_DEEP_FILES:
                warn("stopped after %d source files; re-run on a smaller path"
                     % MAX_DEEP_FILES)
                return
            full = os.path.join(dirpath, fn)
            text = read_text(full)
            if text is None:
                continue
            scan_build_code(sc, text, rel_display(root, display, full), pkg,
                            net_rule=net_rule, net_re=net_re)


def detect_ecosystems(path: str) -> list[str]:
    found: list[str] = []
    if os.path.isfile(os.path.join(path, "Cargo.toml")):
        found.append("cargo")
    if any(os.path.isfile(os.path.join(path, f))
           for f in ("setup.py", "setup.cfg", "pyproject.toml",
                     "requirements.txt")):
        found.append("python")
    if os.path.isfile(os.path.join(path, "go.mod")):
        found.append("go")
    return found


SCANNERS = {"cargo": scan_cargo, "python": scan_python, "go": scan_go}


def scan_file(sc: Scanner, path: str) -> None:
    """A single file named on the command line."""
    low = path.lower()
    if low.endswith(".pth"):
        scan_pth(sc, path, path, "")
        return
    text = read_text(path)
    if text is None:
        return
    base = os.path.basename(low)
    if base == "cargo.lock":
        scan_cargo_lock(sc, path, path, "")
    elif base == "cargo.toml":
        scan_cargo_manifest(sc, path, path,
                            os.path.dirname(os.path.abspath(path)), True)
    elif base in ("config.toml", "config") and os.path.basename(
            os.path.dirname(os.path.abspath(path))) == ".cargo":
        scan_cargo_config(sc, path, path, "")
    elif base == "pyproject.toml":
        scan_pyproject(sc, path, path, os.path.dirname(os.path.abspath(path)), "")
    elif base == "go.mod":
        scan_go_mod(sc, path, path)
    elif low.endswith(".go"):
        scan_go_source(sc, text, path, "")
    elif base.startswith("requirements") and low.endswith((".txt", ".in")):
        scan_requirements(sc, path, path, "")
    elif low.endswith(".rs"):
        scan_build_code(sc, text, path, "", net_rule="exec.build-rs-network",
                        net_re=RUST_NET_RE)
    elif low.endswith(".py"):
        scan_build_code(sc, text, path, "", net_rule="exec.setup-py-network",
                        net_re=PY_NET_RE)
    else:
        scan_unicode(sc, text, path)
        scan_obfuscation(sc, text, path)


def scan_paths(paths: list[str], ecosystems: list[str], deep: bool = False,
               warn=lambda m: None) -> list[Finding]:
    sc = Scanner()
    for path in paths:
        if os.path.isdir(path):
            display = path.rstrip("/") or "."
            want = ecosystems or detect_ecosystems(path)
            if not want:
                warn("%s: no Cargo.toml, setup.py/pyproject.toml or go.mod, "
                     "nothing to scan" % path)
                continue
            for eco in want:
                SCANNERS[eco](sc, path, display, deep, warn)
            continue
        if os.path.isfile(path):
            scan_file(sc, path)
            continue
        warn("%s: no such file or directory" % path)
    findings = sc.findings
    findings.sort(key=lambda f: (-SEV_RANK[f.severity], f.file, f.line, f.id))
    return findings


# --------------------------------------------------------------------------
# output
# --------------------------------------------------------------------------

COLORS = {SEV_HIGH: "\033[1;31m", SEV_MEDIUM: "\033[1;33m", SEV_LOW: "\033[36m"}
RESET = "\033[0m"
DIM = "\033[2m"


def summarize(findings: list[Finding]) -> dict[str, int]:
    counts = {SEV_HIGH: 0, SEV_MEDIUM: 0, SEV_LOW: 0}
    for f in findings:
        counts[f.severity] += 1
    return counts


def render_table(findings: list[Finding], color: bool, out, suppressed: int = 0,
                 max_per_rule: int = 10, bypass: str = "the build") -> None:
    if not findings:
        out.write("clean: no findings\n")
        if suppressed:
            out.write("(%d finding(s) hidden by allow rules)\n" % suppressed)
        return
    width = max(len(f.severity) for f in findings)
    idw = max(len(f.id) for f in findings)
    shown: dict[str, int] = {}
    elided: dict[str, int] = {}
    for f in findings:
        n = shown.get(f.id, 0)
        if max_per_rule and n >= max_per_rule:
            elided[f.id] = elided.get(f.id, 0) + 1
            continue
        shown[f.id] = n + 1
        loc = "%s:%d" % (f.file, f.line)
        sev = f.severity.upper().ljust(width)
        if color:
            sev = "%s%s%s" % (COLORS[f.severity], sev, RESET)
        out.write("%s  %s  %s\n" % (sev, f.id.ljust(idw), loc))
        pad = " " * (width + 2)
        if color:
            out.write("%s%s%s%s\n" % (pad, DIM, f.evidence, RESET))
            out.write("%s%swhy:     %s%s\n" % (pad, DIM, f.why, RESET))
            out.write("%s%sproceed: %s%s\n" % (pad, DIM, f.proceed, RESET))
        else:
            out.write("%s%s\n" % (pad, f.evidence))
            out.write("%swhy:     %s\n" % (pad, f.why))
            out.write("%sproceed: %s\n" % (pad, f.proceed))
    for rule, n in sorted(elided.items()):
        out.write("     ... and %d more %s finding(s) (--max-per-rule 0 for all)\n"
                  % (n, rule))
    counts = summarize(findings)
    out.write(
        "\n%d finding(s): %d high, %d medium, %d low%s\n"
        % (
            len(findings),
            counts["high"],
            counts["medium"],
            counts["low"],
            " (%d hidden by allow rules)" % suppressed if suppressed else "",
        )
    )
    render_footer(findings, out, bypass)


def render_footer(findings: list[Finding], out, bypass: str) -> None:
    worst = max(findings, key=lambda f: SEV_RANK[f.severity])
    pkg = worst.pkg or "<package>"
    host = next((f.host for f in findings if f.host), "")
    out.write("\nIf this is expected:\n")
    if host:
        out.write("  trust that host       echo 'host=%s' >> %s\n" % (host, ALLOW_USER))
    out.write("  accept one rule here  echo 'pkg=%s rule=%s' >> %s\n"
              % (pkg, worst.id, ALLOW_USER))
    out.write("  read it first         less %s   # then re-run this scan\n" % worst.file)
    out.write("  build anyway          MOAT_SANDBOX=0 %s"
              "   # skips the sandbox and this scan\n" % bypass)
    out.write("  allow-file syntax     host=<domain> | rule=<id> | pkg=<name>, "
              "'#' comments\n")


