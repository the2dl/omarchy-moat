# --------------------------------------------------------------------------
# findings
# --------------------------------------------------------------------------


@dataclass
class Finding:
    id: str
    severity: str
    file: str
    line: int
    evidence: str
    why: str
    proceed: str
    pkg: str = ""     # owning package name, for allow-file matching
    host: str = ""    # host involved, for allow-file matching

    def as_dict(self) -> dict:
        return {
            "id": self.id,
            "severity": self.severity,
            "file": self.file,
            "line": self.line,
            "evidence": self.evidence,
            "why": self.why,
            "proceed": self.proceed,
            "pkg": self.pkg,
        }


class Scanner:
    def __init__(self) -> None:
        self.findings: list[Finding] = []
        self._seen: set[tuple[str, str, int]] = set()

    def add(
        self,
        rule: str,
        file: str,
        line: int,
        evidence: str,
        severity: str | None = None,
        why: str | None = None,
        pkg: str = "",
        host: str = "",
        escape: bool = False,
    ) -> None:
        default_sev, default_why, proceed = RULES[rule]
        key = (rule, file, line)
        if key in self._seen:
            return
        self._seen.add(key)
        self.findings.append(
            Finding(
                id=rule,
                severity=severity or default_sev,
                file=file,
                line=line,
                evidence=clean_evidence(evidence, escape_invisible=escape),
                why=why or default_why,
                proceed=proceed.format(
                    pkg=pkg or "<package>", id=rule, host=host or "<host>",
                    file=file,
                ),
                pkg=pkg,
                host=host,
            )
        )


# --------------------------------------------------------------------------
# allow file:  host=<domain> | rule=<id> | pkg=<name>, '#' comments.
# Identical syntax and identical files to the other two scanners, so one
# `rule=obf.*` line covers all three tools.
# --------------------------------------------------------------------------

ALLOW_KEYS = ("host", "rule", "pkg")


def allow_file_paths(extra: list[str] | None = None) -> list[str]:
    env = os.environ.get("MOAT_SCANNER_ALLOW", "")
    paths = [ALLOW_SYSTEM]
    xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(
        os.path.expanduser("~"), ".config"
    )
    paths.append(os.path.join(xdg, "moat", "scanner-allow.conf"))
    paths.extend(p for p in env.split(":") if p)
    paths.extend(extra or [])
    return paths


def load_allow(paths: list[str]) -> list[dict[str, str]]:
    entries: list[dict[str, str]] = []
    for path in paths:
        try:
            with open(os.path.expanduser(path), encoding="utf-8", errors="replace") as fh:
                body = fh.read()
        except OSError:
            continue
        for raw in body.splitlines():
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            entry: dict[str, str] = {}
            for tok in re.split(r"[\s,]+", line):
                key, _, val = tok.partition("=")
                if key in ALLOW_KEYS and val:
                    entry[key] = val.strip("'\"")
            if entry:
                entries.append(entry)
    return entries


def host_matches(host: str, pattern: str) -> bool:
    host = host.lower()
    pattern = pattern.lower().lstrip(".")
    if not host:
        return False
    return host == pattern or host.endswith("." + pattern) or fnmatch.fnmatch(host, pattern)


def is_allowed(f: Finding, entries: list[dict[str, str]]) -> bool:
    for entry in entries:
        ok = True
        for key, val in entry.items():
            if key == "rule":
                ok = ok and (f.id == val or fnmatch.fnmatch(f.id, val))
            elif key == "pkg":
                ok = ok and bool(f.pkg) and (f.pkg == val or fnmatch.fnmatch(f.pkg, val))
            elif key == "host":
                ok = ok and host_matches(f.host, val)
            if not ok:
                break
        if ok:
            return True
    return False


# --------------------------------------------------------------------------
# evidence and invisible Unicode
# --------------------------------------------------------------------------

INVISIBLE_RANGES = (
    (0x00AD, 0x00AD),    # soft hyphen
    (0x061C, 0x061C),    # arabic letter mark
    (0x180E, 0x180E),    # mongolian vowel separator
    (0x200B, 0x200F),    # zero width space .. RLM
    (0x2028, 0x202E),    # line/para sep, bidi embedding/override
    (0x2060, 0x2064),    # word joiner .. invisible plus
    (0x2066, 0x206F),    # bidi isolates, deprecated formatting
    (0x3164, 0x3164),    # hangul filler (GlassWorm)
    (0xFE00, 0xFE0F),    # variation selectors
    (0xFEFF, 0xFEFF),    # BOM / zero width no-break space
    (0xFFA0, 0xFFA0),    # halfwidth hangul filler (GlassWorm)
    (0xE0000, 0xE007F),  # tag characters
    (0xE0100, 0xE01EF),  # variation selectors supplement (GlassWorm)
)


def is_invisible(ch: str) -> bool:
    cp = ord(ch)
    for lo, hi in INVISIBLE_RANGES:
        if lo <= cp <= hi:
            return True
    return False


def clean_evidence(text: str, escape_invisible: bool = False) -> str:
    out: list[str] = []
    for ch in text:
        if escape_invisible and (
            is_invisible(ch)
            or (ord(ch) > 127 and unicodedata.category(ch) in ("Cf", "Cc", "Co", "Cs"))
        ):
            out.append("\\u%04x" % ord(ch) if ord(ch) <= 0xFFFF else "\\U%08x" % ord(ch))
        elif ch in "\t\r\n":
            out.append(" ")
        else:
            out.append(ch)
    s = re.sub(r"\s+", " ", "".join(out)).strip()
    if len(s) > EVIDENCE_MAX:
        s = s[: EVIDENCE_MAX - 3] + "..."
    return s


def scan_unicode(sc: Scanner, text: str, display: str, pkg: str = "") -> None:
    for idx, raw in enumerate(text.splitlines(), start=1):
        bad: list[str] = []
        for ch in raw:
            cp = ord(ch)
            if cp < 128:
                continue
            if is_invisible(ch) or unicodedata.category(ch) in ("Cf", "Cc", "Co", "Cs"):
                label = "U+%04X" % cp
                if label not in bad:
                    bad.append(label)
        if not bad:
            continue
        bom_only = bad == ["U+FEFF"] and idx == 1 and raw.startswith("﻿")
        sev = SEV_LOW if bom_only else SEV_HIGH
        why = (
            "file starts with a UTF-8 BOM; harmless, but nothing here writes one"
            if bom_only
            else "line contains invisible/bidi Unicode (%s) that hides code from review"
            % ", ".join(bad[:6])
        )
        sc.add("uni.invisible-chars", display, idx, raw, severity=sev, why=why,
               pkg=pkg, escape=True)


# --------------------------------------------------------------------------
# url helpers
# --------------------------------------------------------------------------


def url_host(url: str) -> str:
    m = re.match(r"[a-zA-Z][a-zA-Z0-9+.\-]*://(?:[^/@\s]*@)?([^/:\s?#]+)", url)
    if not m:
        return ""
    return m.group(1).lower().rstrip(".")


def is_raw_ip(host: str) -> bool:
    if not IPV4_RE.match(host):
        return False
    parts = [int(p) for p in host.split(".") if p.isdigit()]
    return len(parts) == 4 and not any(p > 255 for p in parts)


def is_private_ip(host: str) -> bool:
    if not is_raw_ip(host):
        return False
    a, b = (int(x) for x in host.split(".")[:2])
    if a in (0, 10, 127):
        return True
    if a == 192 and b == 168:
        return True
    if a == 172 and 16 <= b <= 31:
        return True
    return a == 169 and b == 254


def is_known_forge(host: str) -> bool:
    host = host.lower()
    return any(host == h or host.endswith("." + h) for h in KNOWN_FORGES)


def suspicious_reason(url: str) -> str | None:
    low = url.lower()
    for frag in SUSPICIOUS_URL_SUBSTRINGS:
        if frag in low:
            return frag
    host = url_host(url)
    if not host:
        return None
    for frag in SUSPICIOUS_HOST_SUBSTRINGS:
        if frag in host:
            return frag
    if is_raw_ip(host) and not is_private_ip(host):
        return host
    return None


def check_url(sc: Scanner, url: str, display: str, line: int, evidence: str,
              pkg: str = "") -> bool:
    """Report an unambiguously hostile URL. -> True when it fired."""
    reason = suspicious_reason(url)
    if not reason:
        return False
    sc.add("net.suspicious-host", display, line, evidence,
           why="names %s, which is a paste bin, tunnel, webhook or bare public "
               "IP - never a build dependency" % reason,
           pkg=pkg, host=url_host(url))
    return True


