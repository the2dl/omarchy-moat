SHELL_PIPE_RE = re.compile(
    r"(?:curl|wget|fetch|aria2c|http|https)\b[^|;&\n]{0,200}\|\s*"
    r"(?:sudo\s+)?(?:/(?:usr/)?bin/)?(?:ba|z|k|da|a)?sh\b"
    r"|(?:curl|wget)\b[^|;&\n]{0,200}\|\s*(?:python3?|perl|ruby|node)\b"
    r"|(?:ba|z)?sh\s+-c\s+[\"']?\$\(\s*(?:curl|wget)"
    r"|(?:ba|z)?sh\s+<\(\s*(?:curl|wget)"
    r"|eval\s+[\"']?\$\(\s*(?:curl|wget)"
)

# Credential material.  Each of these is a file whose only value is to be
# stolen; a build step has no reason to read one.
CREDENTIAL_RE = re.compile(
    r"\.ssh\b|\bid_rsa\b|\bid_ed25519\b|\bid_ecdsa\b"
    r"|\.npmrc\b|_authToken|\.yarnrc\.yml\b"
    r"|\.aws\b|\.gnupg\b|\.netrc\b|\.git-credentials\b|\.pypirc\b"
    r"|\.docker/config|\.kube/config|\.config/gcloud|\.azure\b"
    r"|\.gem/credentials|Library/Keychains|\.local/share/keyrings"
    r"|credentials\.toml|\.cargo/credentials"
    r"|GITHUB_TOKEN|NPM_TOKEN|AWS_SECRET|AWS_ACCESS_KEY|CARGO_REGISTRY_TOKEN"
    r"|PYPI_(?:TOKEN|PASSWORD)|TWINE_PASSWORD",
    re.IGNORECASE,
)

# Spawning one of these *is* the download; no pipe needed.
SHELL_FETCH_SPAWN_RE = re.compile(
    r"""(?:Command|command)\s*::\s*new\s*\(\s*["'](curl|wget|aria2c|nc|ncat|socat)["']"""
    r"""|exec\s*\.\s*Command\s*\(\s*["'](?:/usr/bin/|/bin/)?(curl|wget|aria2c|nc|ncat|socat)["']"""
    r"""|(?:subprocess|os)\s*\.\s*\w+\s*\(\s*\[?\s*["'](curl|wget|aria2c)["']"""
)

# Rust: an HTTP client or a raw socket, in call form.  Bare crate names are
# deliberately not matched - a build.rs that merely mentions "hyper" in a
# feature string is not opening a connection.
RUST_NET_RE = re.compile(
    r"\breqwest\s*::"
    r"|\bureq\s*::"
    r"|\battohttpc\s*::"
    r"|\bisahc\s*::"
    r"|\bminreq\s*::"
    r"|\bcurl\s*::\s*(?:easy|Easy)"
    r"|\bhyper\s*::\s*[Cc]lient"
    r"|\bTcpStream\s*::\s*connect"
    r"|\bUdpSocket\s*::\s*(?:bind|connect)"
    r"|\bhttp_req\s*::"
)

# Python: the same, for setup.py and PEP 517 backends.
PY_NET_RE = re.compile(
    # Call forms only.  `import urllib.request` at the top of a setup.py that
    # only ever parses a URL is not a fetch, and used to fire here.
    r"\burllib\s*\.\s*request\s*\.\s*(?:urlopen|urlretrieve|Request|build_opener)\s*\("
    r"|(?<![.\w])urlopen\s*\(|(?<![.\w])urlretrieve\s*\("
    r"|\brequests\s*\.\s*(?:get|post|put|head|request|Session)\s*\("
    r"|\bhttpx\s*\.\s*(?:get|post|stream|Client)\s*\("
    r"|\baiohttp\s*\.\s*ClientSession\s*\("
    r"|\bsocket\s*\.\s*(?:socket|create_connection)\s*\("
    r"|\bhttp\s*\.\s*client\s*\.\s*HTTP|\bftplib\s*\.|\bxmlrpc\s*\."
    r"|\bpip\s*\.\s*_internal\b"
    # NOT a bare "pip install": it appears in help text, error messages and
    # comments in ordinary setup.py files (ruamel.yaml has five), and running
    # pip is a nested-package-manager concern, not a network verb.
)

# A line that is only a comment cannot run.  Skipping them is what keeps the
# network and credential rules off the prose in an ordinary setup.py.
COMMENT_ONLY_RE = re.compile(r"^\s*(?:#|//|/\*|\*(?!/)|--)")

# --------------------------------------------------------------------------
# obfuscation engine
#
# The engine moat-scan-npm uses, with the decoder and sink vocabulary of Rust
# and Go added.  Nothing here executes, imports, writes or resolves anything:
# decode_blob is pure base64, and it exists so a finding can tell the reader
# what the blob says instead of making them run it.
# --------------------------------------------------------------------------

DECODER_RE = re.compile(
    # JavaScript / Python (shared with moat-scan-npm)
    r"\batob\s*\("
    r"|\bbase64\s*\.\s*(?:b64decode|b32decode|b16decode|urlsafe_b64decode|"
    r"standard_b64decode|decodebytes)\s*\("
    r"|\bcodecs\s*\.\s*decode\s*\("
    r"|\bbytes\s*\.\s*fromhex\s*\("
    r"|\bmarshal\s*\.\s*loads\s*\("
    r"|\bzlib\s*\.\s*decompress\s*\("
    r"|\bbinascii\s*\.\s*(?:a2b_base64|unhexlify)\s*\("
    # Rust
    r"|\bbase64\s*::\s*(?:decode|prelude)"
    r"|\bSTANDARD\s*\.\s*decode\s*\("
    r"|\bgeneral_purpose\s*::\s*[A-Z_]+\s*\.\s*decode\s*\("
    r"|\bhex\s*::\s*decode\s*\("
    # NOT String::from_utf8 / str::from_utf8: turning a child process's stdout
    # into a String is what every -sys crate's build.rs does with `rustc
    # --version`, and treating it as a decoder made ten real crates on this
    # machine report obf.eval-decoded. When it genuinely wraps a decode, the
    # inner base64::decode already taints the value.
    # Go
    r"|\bbase64\s*\.\s*[A-Za-z]*Encoding\s*\.\s*DecodeString\s*\("
    r"|\bhex\s*\.\s*DecodeString\s*\("
)

# Sinks that turn a string into a running program.  The `.`-prefixed and
# argument-shaped ones are only sinks when the file actually spawns processes,
# exactly as `.exec(` is only a sink when a JS file has child_process in it.
SINK_RE = re.compile(
    r"\beval\s*\("
    r"|(?<![.\w])exec\s*\("
    r"|(?<![.\w])compile\s*\("
    r"|\bos\s*\.\s*system\s*\("
    r"|\bsubprocess\s*\.\s*(?:run|call|Popen|check_output|check_call)\s*\("
    r"|\bCommand\s*::\s*new\s*\("
    r"|\bexec\s*\.\s*Command\s*\("
    r"|\bsyscall\s*\.\s*Exec\s*\("
    r"|\.\s*(?:arg|args|raw_arg)\s*\("
)

PROCESS_HINT_RE = re.compile(
    r"child_process|subprocess|os\.system|Command\s*::\s*new|os/exec"
    r"|exec\.Command|syscall\.Exec"
)

FROMCHARCODE_RE = re.compile(
    r"(?:String\s*\.\s*fromCharCode|char\s*::\s*from_u32|(?<![\w.])chr)"
    r"\s*\(([^)]{0,4000})\)"
)
CHARCODE_CHAIN_MIN = 4

# A Rust/Go byte array of character codes: `[104u8, 116, 116, 112, ...]`.
BYTE_ARRAY_RE = re.compile(r"[\[{]\s*((?:\d{1,3}\s*(?:u8|b)?\s*,\s*){7,}\d{1,3}\s*(?:u8|b)?)\s*[\]}]")

STRING_LIT_RE = re.compile(r"'([^'\\\n]*)'|\"([^\"\\\n]*)\"|`([^`\\\n]*)`")
BLOB_LIT_RE = re.compile(r"""(['"])([A-Za-z0-9+/=_\-]{400,})\1""")
HEX_LIT_RE = re.compile(r"""(['"])((?:[0-9a-fA-F]{2}){400,})\1""")

# Covers `const d = ...`, `let mut d = ...`, `let d: Vec<u8> = ...` (Rust) and
# `d := ...` (Go) as well as the JavaScript/Python forms.
_ASSIGN_HEAD = (
    r"^\s*(?:(?:const|let|var|static)\s+)?(?:mut\s+)?"
    r"([A-Za-z_$][\w$]*)\s*(?::\s*[^=;\n]{0,80})?\s*:?=\s*"
)
ASSIGN_RE = re.compile(_ASSIGN_HEAD + r"(.+)$")
LITERAL_ASSIGN_RE = re.compile(_ASSIGN_HEAD + r"""['"]([^'"\n]{16,})['"]""")

LONG_LINE_CHARS = 5000

# Paths where a huge line or a huge literal is the normal state of the world.
GENERATED_HINTS = (
    ".pb.go", "_gen.go", ".gen.go", "_generated.go", ".generated.rs",
    "/target/", "/dist/", "/build/", "/vendor/golang.org/",
    "/fixtures/", "/__fixtures__/", "/testdata/", "/coverage/",
    ".min.js", ".map", ".wasm",
)

MAX_TAINT = 64


def looks_generated(path: str) -> bool:
    low = path.replace(os.sep, "/").lower()
    return any(h in low for h in GENERATED_HINTS)


def has_decoder(text: str) -> bool:
    if DECODER_RE.search(text):
        return True
    for m in FROMCHARCODE_RE.finditer(text):
        if len(re.findall(r"\b\d{1,7}\b", m.group(1))) >= CHARCODE_CHAIN_MIN:
            return True
    return BYTE_ARRAY_RE.search(text) is not None


def balanced_arg(text: str, open_pos: int, limit: int = 2000) -> str:
    """Text between the '(' at open_pos and its matching ')', capped."""
    depth = 0
    out: list[str] = []
    for i in range(open_pos, min(len(text), open_pos + limit)):
        ch = text[i]
        if ch == "(":
            depth += 1
            if depth == 1:
                continue
        elif ch == ")":
            depth -= 1
            if depth == 0:
                break
        if depth >= 1:
            out.append(ch)
    return "".join(out)


def decode_blob(blob: str) -> str:
    """base64 -> text, or "" if it is not base64 or not text.

    Pure decoding: nothing here executes, imports, writes or resolves
    anything.
    """
    if len(blob) < 8 or len(blob) % 4 or not re.fullmatch(r"[A-Za-z0-9+/=]+", blob):
        return ""
    try:
        text = base64.b64decode(blob, validate=True).decode("utf-8")
    except (binascii.Error, ValueError, UnicodeDecodeError):
        return ""
    printable = sum(1 for c in text if c.isprintable() or c in "\n\t")
    if not text or printable / len(text) < 0.9:
        return ""
    return text


def try_decode(text: str) -> str:
    """Decode the literals inside an expression, for evidence only."""
    out: list[str] = []
    for m in re.finditer(r"""['"]([A-Za-z0-9+/=]{8,20000})['"]""", text):
        got = decode_blob(m.group(1))
        if got:
            out.append(got)
    for m in FROMCHARCODE_RE.finditer(text):
        nums = re.findall(r"\b(\d{1,7})\b", m.group(1))
        if nums:
            try:
                out.append("".join(chr(int(n)) for n in nums if int(n) < 0x110000))
            except (ValueError, OverflowError):
                pass
    for m in BYTE_ARRAY_RE.finditer(text):
        nums = re.findall(r"\b(\d{1,3})\b", m.group(1))
        try:
            out.append("".join(chr(int(n)) for n in nums if int(n) < 256))
        except (ValueError, OverflowError):
            pass
    return " ".join(out)


def taint_names(lines: list[str]) -> tuple[dict[str, str], dict[str, str]]:
    """-> (name -> assigning expression, name -> plain string literal)."""
    tainted: dict[str, str] = {}
    literals: dict[str, str] = {}
    for raw in lines:
        lm = LITERAL_ASSIGN_RE.match(raw)
        if lm and len(literals) < MAX_TAINT * 4:
            literals[lm.group(1)] = lm.group(2)
        if len(tainted) >= MAX_TAINT:
            continue
        m = ASSIGN_RE.match(raw)
        if not m:
            continue
        name, rhs = m.group(1), m.group(2)
        if has_decoder(rhs) or BLOB_LIT_RE.search(rhs) or HEX_LIT_RE.search(rhs):
            tainted[name] = rhs
            continue
        for other in list(tainted):
            if other != name and re.search(r"\b%s\b" % re.escape(other), rhs):
                tainted[name] = rhs
                break
    return tainted, literals


def arg_is_tainted(arg: str, tainted: dict[str, str]) -> str | None:
    # Only identifiers count. `.arg("--version")` is not a use of a variable
    # called `version`, and matching inside the literal was a false positive
    # on every build.rs that shells out to `rustc --version`.
    code = STRING_LIT_RE.sub('""', arg)
    for name in tainted:
        if re.search(r"\b%s\b" % re.escape(name), code):
            return name
    return None


def taint_evidence(name: str, tainted: dict[str, str], literals: dict[str, str],
                   depth: int = 0) -> str:
    """Follow a tainted name back to the literal it came from and decode it."""
    rhs = tainted.get(name, "")
    if not rhs:
        return ""
    got = try_decode(rhs)
    if got.strip() or depth >= 2:
        return got
    for ident in re.findall(r"[A-Za-z_$][\w$]*", rhs):
        if ident in literals:
            got = decode_blob(literals[ident])
            if got.strip():
                return got
        elif ident in tainted and ident != name:
            got = taint_evidence(ident, tainted, literals, depth + 1)
            if got.strip():
                return got
    return ""


def line_at(text: str, pos: int) -> int:
    return text.count("\n", 0, pos) + 1


def scan_obfuscation(sc: Scanner, text: str, display: str, pkg: str = "", *,
                     low_rules: bool = True) -> None:
    """Obfuscation heuristics over one Rust, Python or Go source text."""
    if not text:
        return
    lines = text.splitlines()
    tainted, literals = taint_names(lines)
    spawns = PROCESS_HINT_RE.search(text) is not None

    for m in SINK_RE.finditer(text):
        head = m.group(0).lstrip()
        if head.startswith(".") and not spawns:
            continue
        paren = text.find("(", m.start())
        if paren < 0:
            continue
        arg = balanced_arg(text, paren)
        if not arg.strip():
            continue
        sink = clean_evidence(m.group(0))
        hit = ""
        chased = ""
        if has_decoder(arg):
            hit = "decoded inline"
        else:
            name = arg_is_tainted(arg, tainted)
            if name:
                hit = "argument %s was decoded above" % name
                chased = taint_evidence(name, tainted, literals)
        if not hit:
            continue
        decoded = chased or try_decode(arg)
        ev = "%s%s )  [%s]" % (sink, clean_evidence(arg)[:80], hit)
        if decoded.strip():
            ev += "  decodes to: " + clean_evidence(decoded)[:60]
        sc.add("obf.eval-decoded", display, line_at(text, m.start()), ev, pkg=pkg)

    for m in FROMCHARCODE_RE.finditer(text):
        if len(re.findall(r"\b\d{1,7}\b", m.group(1))) < 8:
            continue
        decoded = try_decode(m.group(0))
        ev = clean_evidence(m.group(0))
        if decoded.strip():
            ev += "  decodes to: " + clean_evidence(decoded)[:60]
        sc.add("obf.charcode-chain", display, line_at(text, m.start()), ev, pkg=pkg)

    if not low_rules or looks_generated(display):
        return

    for m in BLOB_LIT_RE.finditer(text):
        sc.add("obf.long-blob", display, line_at(text, m.start()),
               "%d-char encoded literal: %s..." % (len(m.group(2)), m.group(2)[:48]),
               pkg=pkg)
        break
    for m in HEX_LIT_RE.finditer(text):
        sc.add("obf.long-blob", display, line_at(text, m.start()),
               "%d-char hex literal: %s..." % (len(m.group(2)), m.group(2)[:48]),
               pkg=pkg)
        break
    for no, raw in enumerate(lines, start=1):
        if len(raw) > LONG_LINE_CHARS:
            sc.add("obf.long-line", display, no,
                   "line is %d characters: %s..." % (len(raw), raw[:60]), pkg=pkg)
            break


# --------------------------------------------------------------------------
# the build-code sweep: everything above, applied to one file that runs
# before the user has run anything.
# --------------------------------------------------------------------------


def scan_build_code(sc: Scanner, text: str, display: str, pkg: str, *,
                    net_rule: str, net_re: re.Pattern[str] | None,
                    low_rules: bool = True) -> None:
    if not text:
        return
    scan_unicode(sc, text, display, pkg)
    scan_obfuscation(sc, text, display, pkg, low_rules=low_rules)

    lines = text.splitlines()

    for no, raw in enumerate(lines, start=1):
        if COMMENT_ONLY_RE.match(raw):
            continue
        if SHELL_PIPE_RE.search(raw):
            sc.add("net.curl-pipe-shell", display, no, raw, pkg=pkg)
        if CREDENTIAL_RE.search(raw):
            sc.add("cred.build-read", display, no, raw, pkg=pkg)
        for m in URL_RE.finditer(raw):
            check_url(sc, m.group(0), display, no, raw, pkg=pkg)

    if net_re is None:
        return

    # A URL anywhere in the file tells the reader where the fetch goes; a
    # suspicious one has already fired net.suspicious-host above.
    urls = [m.group(0) for m in URL_RE.finditer(text)]
    fallback = (next((u for u in urls if suspicious_reason(u)), "")
                or (urls[0] if urls else ""))

    for no, raw in enumerate(lines, start=1):
        if COMMENT_ONLY_RE.match(raw):
            continue
        spawn = SHELL_FETCH_SPAWN_RE.search(raw)
        if not (spawn or net_re.search(raw)):
            continue
        # Name the URL on this line if there is one; the file-level fallback
        # only says where the file as a whole points.
        here = [m.group(0) for m in URL_RE.finditer(raw)]
        target = (next((u for u in here if suspicious_reason(u)), "")
                  or (here[0] if here else "")
                  or fallback)
        host = url_host(target)
        # The same ladder as npm.script-net-literal: an ordinary https host at
        # build time is a bad idea, a paste bin or a bare IP is an attack, and
        # spawning curl/wget is an attack whatever the host.
        if spawn or not host or suspicious_reason(target):
            sev = None            # the rule's default: high
        else:
            sev = SEV_MEDIUM
        ev = raw if not target else "%s   -> %s" % (raw.strip(), target)
        sc.add(net_rule, display, no, ev, severity=sev, pkg=pkg, host=host)


# --------------------------------------------------------------------------
# file io
# --------------------------------------------------------------------------


def read_text(path: str, cap: int = MAX_SOURCE_BYTES) -> str | None:
    try:
        if os.path.getsize(path) > cap:
            return None
        with open(path, "rb") as fh:
            data = fh.read()
    except OSError:
        return None
    if b"\x00" in data[:4096]:
        return None
    return data.decode("utf-8", errors="replace")


def rel_display(root: str, display: str, full: str) -> str:
    """Display path for a file under root, keeping the caller's spelling."""
    try:
        rel = os.path.relpath(full, root)
    except ValueError:
        return full
    if rel.startswith(".."):
        return full
    return rel if display in (".", "") else os.path.join(display, rel)


def escapes(base: str, target: str) -> bool:
    """True when the *spelling* target, resolved against base, leaves base."""
    if os.path.isabs(target):
        return True
    norm = os.path.normpath(os.path.join(base, target))
    base = os.path.normpath(base)
    return norm != base and not norm.startswith(base + os.sep)


SKIP_DIRS = (".git", ".hg", ".svn", "node_modules", "target", "__pycache__",
             ".mypy_cache", ".pytest_cache", ".tox", ".ruff_cache", ".cache")


def walk(root: str, limit: int = MAX_WALK_DIRS):
    """os.walk with the noise directories pruned and a hard directory cap."""
    seen = 0
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        seen += 1
        if seen > limit:
            return
        yield dirpath, dirnames, filenames


def outside(root: str, resolved: str) -> bool:
    """True when an already-resolved path is not under root."""
    root = os.path.normpath(os.path.abspath(root))
    resolved = os.path.normpath(os.path.abspath(resolved))
    return resolved != root and not resolved.startswith(root + os.sep)


# --------------------------------------------------------------------------
# a small, section-aware TOML line reader
#
# Deliberately line-based rather than tomllib: every finding needs a line
# number, and a manifest that a strict parser rejects must not make the
# scanner blind to the text cargo and pip will still act on.
# --------------------------------------------------------------------------


@dataclass
class TomlEntry:
    section: str
    key: str
    value: str
    line: int
    raw: str


TOML_SECTION_RE = re.compile(r"^\s*\[\[?\s*(.+?)\s*\]\]?\s*(?:#.*)?$")
TOML_KEY_RE = re.compile(r"^\s*((?:\"[^\"]*\"|'[^']*'|[A-Za-z0-9_.\-]+)"
                         r"(?:\s*\.\s*(?:\"[^\"]*\"|[A-Za-z0-9_.\-]+))*)\s*=\s*(.*)$")


def strip_toml_comment(s: str) -> str:
    out: list[str] = []
    quote = ""
    i = 0
    while i < len(s):
        ch = s[i]
        if quote:
            if ch == "\\" and quote == '"':
                out.append(ch)
                i += 1
                if i < len(s):
                    out.append(s[i])
                    i += 1
                continue
            if ch == quote:
                quote = ""
        elif ch in "\"'":
            quote = ch
        elif ch == "#":
            break
        out.append(ch)
        i += 1
    return "".join(out).rstrip()


def toml_entries(text: str) -> list[TomlEntry]:
    """Every `key = value` with the section it sits in, and its line."""
    lines = text.splitlines()
    out: list[TomlEntry] = []
    section = ""
    i = 0
    while i < len(lines):
        raw = lines[i]
        stripped = strip_toml_comment(raw).strip()
        i += 1
        if not stripped:
            continue
        sm = TOML_SECTION_RE.match(stripped)
        if sm:
            section = sm.group(1).strip()
            continue
        km = TOML_KEY_RE.match(stripped)
        if not km:
            continue
        key = km.group(1).strip().strip("\"'")
        value = km.group(2).strip()
        start = i  # 1-based line of the key
        # Join a multi-line array or inline table.
        joined = 0
        while joined < MAX_TOML_CONT and unbalanced(value) and i < len(lines):
            value += " " + strip_toml_comment(lines[i]).strip()
            i += 1
            joined += 1
        out.append(TomlEntry(section, key, value.strip(), start, raw))
    return out


def unbalanced(value: str) -> bool:
    depth = 0
    quote = ""
    for ch in value:
        if quote:
            if ch == quote:
                quote = ""
            continue
        if ch in "\"'":
            quote = ch
        elif ch in "[{":
            depth += 1
        elif ch in "]}":
            depth -= 1
    return depth > 0


def toml_str(value: str) -> str:
    value = value.strip()
    for q in ('"""', "'''", '"', "'"):
        if value.startswith(q) and value.endswith(q) and len(value) >= 2 * len(q):
            return value[len(q):len(value) - len(q)]
    return ""


def toml_array(value: str) -> list[str]:
    value = value.strip()
    if not (value.startswith("[") and value.endswith("]")):
        return []
    return [g for m in STRING_LIT_RE.finditer(value[1:-1])
            for g in m.groups() if g is not None]


def toml_inline(value: str) -> dict[str, str]:
    """`{ path = "../x", version = "1" }` -> {'path': '"../x"', ...}."""
    value = value.strip()
    if not (value.startswith("{") and value.endswith("}")):
        return {}
    out: dict[str, str] = {}
    for m in re.finditer(
        r"""([A-Za-z0-9_.\-]+)\s*=\s*("[^"]*"|'[^']*'|\[[^\]]*\]|[^,}]+)""",
        value[1:-1],
    ):
        out[m.group(1)] = m.group(2).strip()
    return out


# ==========================================================================
# cargo
# ==========================================================================

CARGO_DEP_SECTIONS = re.compile(
    r"^(?:workspace\.)?(?:dependencies|dev-dependencies|build-dependencies)$"
    r"|^target\.[^.]+\.(?:dependencies|dev-dependencies|build-dependencies)$"
    r"|^target\.\"[^\"]*\"\.(?:dependencies|dev-dependencies|build-dependencies)$"
)
CARGO_DEP_SUBTABLE = re.compile(
    r"^(?:(?:workspace|target\.[^.]+|target\.\"[^\"]*\")\.)?"
    r"(dependencies|dev-dependencies|build-dependencies)\.(.+)$"
)

# Compiler wrappers that are the ordinary reason [build] rustc-wrapper exists.
BENIGN_WRAPPERS = ("sccache", "cachepot", "ccache", "mold", "lld", "cross")


def cargo_dep_section(section: str) -> tuple[str, str] | None:
    """-> (kind, dep name or "") for a section that declares dependencies."""
    if CARGO_DEP_SECTIONS.match(section):
        kind = section.rsplit(".", 1)[-1]
        return kind, ""
    m = CARGO_DEP_SUBTABLE.match(section)
    if m:
        return m.group(1), m.group(2).strip().strip("\"'")
    return None


def scan_cargo_manifest(sc: Scanner, path: str, display: str, root: str,
                        is_root_pkg: bool) -> tuple[str, str]:
    """-> (package name, build script path relative to the manifest dir)."""
    text = read_text(path)
    if text is None:
        return "", ""
    here = os.path.dirname(os.path.abspath(path))
    entries = toml_entries(text)

    name = ""
    for e in entries:
        if e.section == "package" and e.key == "name":
            name = toml_str(e.value)
            break
    if not name:
        name = os.path.basename(here)

    scan_unicode(sc, text, display, name)

    build_rel = ""
    for e in entries:
        # --- build = "..." ------------------------------------------------
        if e.section == "package" and e.key == "build":
            val = toml_str(e.value)
            if val and val.lower() not in ("false", "true"):
                build_rel = val
                if escapes(here, val):
                    sc.add("cargo.build-script-outside", display, e.line, e.raw,
                           pkg=name)
                    build_rel = ""

        # --- proc-macro ---------------------------------------------------
        if e.section == "lib" and e.key == "proc-macro" and e.value.strip() == "true":
            sc.add("cargo.proc-macro", display, e.line, e.raw,
                   severity=SEV_LOW if is_root_pkg else SEV_MEDIUM,
                   why="a proc-macro crate executes inside rustc while your code "
                       "compiles" + ("" if is_root_pkg else ", and this one is a "
                                     "dependency you did not write"),
                   pkg=name)

        # --- dependency sources -------------------------------------------
        got = cargo_dep_section(e.section)
        if not got:
            continue
        kind, sub = got
        if sub:
            dep_name, fields = sub, {e.key: e.value}
        else:
            dep_name, fields = e.key, toml_inline(e.value)
        if not fields:
            continue

        path_val = toml_str(fields.get("path", ""))
        if path_val and outside(root, os.path.join(here, path_val)):
            sc.add("cargo.dep-outside-tree", display, e.line,
                   "%s: %s (path = %s)" % (kind, dep_name, path_val), pkg=name)

        git_val = toml_str(fields.get("git", ""))
        if git_val:
            if not check_url(sc, git_val, display, e.line,
                             "%s: %s = %s" % (kind, dep_name, git_val), pkg=name):
                host = url_host(git_val)
                pinned = "rev" in fields
                sev = SEV_LOW
                why = None
                if kind == "build-dependencies":
                    sev = SEV_MEDIUM
                    why = ("a git build-dependency is compiled and run at build "
                           "time and no checksum covers it")
                elif host and not is_known_forge(host):
                    sev = SEV_MEDIUM
                    why = ("a git dependency is fetched from %s, which is not a "
                           "known forge" % host)
                if pinned and sev == SEV_LOW:
                    continue
                sc.add("cargo.dep-git", display, e.line,
                       "%s: %s = %s%s" % (kind, dep_name, git_val,
                                          "" if pinned else "  (no rev pin)"),
                       severity=sev, why=why, pkg=name, host=host)

    return name, build_rel


def scan_cargo_config(sc: Scanner, path: str, display: str, pkg: str) -> None:
    text = read_text(path)
    if text is None:
        return
    scan_unicode(sc, text, display, pkg)
    entries = toml_entries(text)

    for e in entries:
        sec = e.section

        # --- [source.*] replace-with / registry ---------------------------
        if sec.startswith("source."):
            which = sec[len("source."):].strip().strip("\"'")
            if e.key == "replace-with":
                sev = SEV_HIGH if which == "crates-io" else SEV_MEDIUM
                sc.add("cargo.registry-replaced", display, e.line,
                       "[%s] %s" % (sec, e.raw.strip()), severity=sev,
                       why=("every crates.io crate is fetched from the '%s' source "
                            "instead, silently, in every build"
                            % toml_str(e.value)) if which == "crates-io" else None,
                       pkg=pkg)
            elif e.key in ("registry", "git", "local-registry", "directory"):
                url = toml_str(e.value)
                if not check_url(sc, url, display, e.line, e.raw.strip(), pkg=pkg):
                    sc.add("cargo.registry-replaced", display, e.line,
                           "[%s] %s" % (sec, e.raw.strip()), severity=SEV_LOW,
                           why="defines an alternative crate source; only "
                               "dangerous once something replaces crates-io with it",
                           pkg=pkg, host=url_host(url))
            continue

        if sec.startswith("registries."):
            url = toml_str(e.value) if e.key == "index" else ""
            if url:
                check_url(sc, url, display, e.line, e.raw.strip(), pkg=pkg)
            continue

        # --- [build] rustc / rustc-wrapper / rustdoc ----------------------
        if sec == "build" and e.key in ("rustc", "rustc-wrapper",
                                        "rustc-workspace-wrapper", "rustdoc"):
            val = toml_str(e.value)
            benign = any(w in os.path.basename(val).lower() for w in BENIGN_WRAPPERS)
            sc.add("cargo.build-runner", display, e.line,
                   "[build] %s" % e.raw.strip(),
                   severity=SEV_MEDIUM if benign else SEV_HIGH,
                   why="cargo runs %r in place of, or around, the compiler for "
                       "every crate it builds" % val,
                   pkg=pkg)
            continue

        if sec == "build" and e.key == "rustflags":
            flags = " ".join(toml_array(e.value)) or toml_str(e.value)
            if re.search(r"-C\s*linker=|-C\s*link-arg|-Z\s|linker-plugin", flags):
                sc.add("cargo.linker-override", display, e.line, e.raw.strip(),
                       pkg=pkg)
            continue

        # --- [target.*] runner / linker / rustflags -----------------------
        if sec.startswith("target."):
            if e.key == "runner":
                sc.add("cargo.build-runner", display, e.line,
                       "[%s] %s" % (sec, e.raw.strip()),
                       why="cargo executes %r instead of the binary on `cargo run`, "
                           "`cargo test` and `cargo bench`" % toml_str(e.value),
                       pkg=pkg)
            elif e.key == "linker":
                sc.add("cargo.linker-override", display, e.line,
                       "[%s] %s" % (sec, e.raw.strip()), pkg=pkg)
            elif e.key == "rustflags":
                flags = " ".join(toml_array(e.value)) or toml_str(e.value)
                if re.search(r"-C\s*linker=|-C\s*link-arg|linker-plugin", flags):
                    sc.add("cargo.linker-override", display, e.line,
                           "[%s] %s" % (sec, e.raw.strip()), pkg=pkg)


CARGO_LOCK_PKG_RE = re.compile(r'^\s*name\s*=\s*"([^"]*)"')


def scan_cargo_lock(sc: Scanner, path: str, display: str, pkg: str) -> None:
    text = read_text(path)
    if text is None:
        return
    lines = text.splitlines()
    # Cargo.lock v1/v2 kept checksums in a [metadata] table; do not claim a
    # missing checksum when they live there.
    metadata_checksums = bool(re.search(r'^\s*"checksum ', text, re.M))

    cur: dict[str, str] = {}
    start = 0
    blocks: list[tuple[dict[str, str], int]] = []
    for no, raw in enumerate(lines, start=1):
        s = raw.strip()
        if s == "[[package]]":
            if cur:
                blocks.append((cur, start))
            cur, start = {}, no
            continue
        if s.startswith("[") and s != "[[package]]":
            if cur:
                blocks.append((cur, start))
            cur, start = {}, 0
            continue
        m = TOML_KEY_RE.match(strip_toml_comment(raw))
        if m and start:
            cur[m.group(1).strip()] = toml_str(m.group(2).strip())
    if cur and start:
        blocks.append((cur, start))

    for block, line in blocks:
        name = block.get("name", "")
        source = block.get("source", "")
        if not source:
            continue  # a path dependency or the workspace itself
        if source.startswith("registry+") or source.startswith("sparse+"):
            if source not in CRATES_IO_INDEX:
                url = source.split("+", 1)[1]
                host = url_host(url)
                if not check_url(sc, url, display, line,
                                 "%s -> %s" % (name, source), pkg=pkg):
                    sc.add("lock.foreign-registry", display, line,
                           "%s -> %s" % (name, source),
                           severity=SEV_MEDIUM if host else SEV_LOW,
                           pkg=name or pkg, host=host)
            if "checksum" not in block and not metadata_checksums:
                sc.add("lock.missing-integrity", display, line,
                       "%s %s has no checksum" % (name, block.get("version", "")),
                       pkg=name or pkg)
        elif source.startswith("git+"):
            url = source[len("git+"):]
            host = url_host(url)
            if not check_url(sc, url, display, line,
                             "%s -> %s" % (name, source), pkg=pkg):
                if host and not is_known_forge(host):
                    sc.add("lock.foreign-registry", display, line,
                           "%s -> %s" % (name, source), pkg=name or pkg, host=host)


def cargo_manifests(root: str) -> list[tuple[str, bool]]:
    """Every Cargo.toml worth reading in this tree. -> [(path, is_root)]."""
    out: list[tuple[str, bool]] = []
    top = os.path.join(root, "Cargo.toml")
    if os.path.isfile(top):
        out.append((top, True))
    for dirpath, dirnames, filenames in walk(root):
        if len(out) >= MAX_MANIFESTS:
            break
        for fn in filenames:
            if fn != "Cargo.toml":
                continue
            full = os.path.join(dirpath, fn)
            if full == top:
                continue
            out.append((full, False))
            if len(out) >= MAX_MANIFESTS:
                break
    return out


def scan_cargo(sc: Scanner, root: str, display: str, deep: bool, warn) -> None:
    manifests = cargo_manifests(root)
    if not manifests:
        return

    root_pkg = ""
    scripts = 0
    for path, is_root in manifests:
        d = rel_display(root, display, path)
        name, build_rel = scan_cargo_manifest(sc, path, d, os.path.abspath(root),
                                              is_root)
        if is_root:
            root_pkg = name
        here = os.path.dirname(path)
        candidates = [build_rel] if build_rel else ["build.rs"]
        for rel in candidates:
            full = os.path.join(here, rel)
            if not os.path.isfile(full) or scripts >= MAX_BUILD_SCRIPTS:
                continue
            scripts += 1
            text = read_text(full)
            if text is None:
                continue
            scan_build_code(sc, text, rel_display(root, display, full), name,
                            net_rule="exec.build-rs-network", net_re=RUST_NET_RE)

    pkg = root_pkg or os.path.basename(os.path.abspath(root))

    lock = os.path.join(root, "Cargo.lock")
    if os.path.isfile(lock):
        scan_cargo_lock(sc, lock, rel_display(root, display, lock), pkg)

    for cfg in cargo_config_files(root):
        scan_cargo_config(sc, cfg, rel_display(root, display, cfg), pkg)

    if deep:
        deep_walk(sc, root, display, warn, pkg, (".rs",), RUST_NET_RE,
                  "exec.build-rs-network")


def cargo_config_files(root: str) -> list[str]:
    """.cargo/config.toml in the project and in every directory above it.

    Stops below $HOME: `~/.cargo/config.toml` is the user's own deliberate
    configuration (a corporate mirror, a cross linker), and firing on it in
    front of every `cargo build` would be exactly the false positive that
    gets a scanner uninstalled.
    """
    out: list[str] = []
    here = os.path.abspath(root)
    home = os.path.abspath(os.path.expanduser("~"))
    for _ in range(MAX_CONFIG_ANCESTORS):
        for fn in ("config.toml", "config"):
            full = os.path.join(here, ".cargo", fn)
            if os.path.isfile(full):
                out.append(full)
        parent = os.path.dirname(here)
        if parent == here or here == home:
            break
        here = parent
    return out


