def classify(path: str) -> str:
    base = os.path.basename(path)
    if base == "PKGBUILD" or base.startswith("PKGBUILD."):
        return "pkgbuild"
    if base.endswith(".install"):
        return "install"
    return "source"


def collect_targets(paths: list[str], warn) -> list[tuple[str, str, str]]:
    """-> [(fs path, display path, kind)]"""
    targets: list[tuple[str, str, str]] = []
    seen: set[str] = set()

    def push(fs: str, display: str, kind: str) -> None:
        key = os.path.realpath(fs)
        if key in seen or not os.path.isfile(fs):
            return
        seen.add(key)
        targets.append((fs, display, kind))

    for p in paths:
        if os.path.isfile(p):
            push(p, p, classify(p))
            if classify(p) == "pkgbuild":
                _push_dir_extras(os.path.dirname(p) or ".", p, push, warn)
            continue
        if os.path.isdir(p):
            pkgbuild = os.path.join(p, "PKGBUILD")
            if os.path.isfile(pkgbuild):
                push(pkgbuild, os.path.normpath(pkgbuild), "pkgbuild")
                _push_dir_extras(p, pkgbuild, push, warn)
            else:
                warn("no PKGBUILD in %s" % p)
                for name in sorted(os.listdir(p)):
                    if name.endswith(".install"):
                        f = os.path.join(p, name)
                        push(f, os.path.normpath(f), "install")
            continue
        warn("not found: %s" % p)
    return targets


def _push_dir_extras(directory: str, pkgbuild: str, push, warn) -> None:
    for name in sorted(os.listdir(directory)):
        if name.endswith(".install"):
            f = os.path.join(directory, name)
            push(f, os.path.normpath(f), "install")
    unit = load_unit(pkgbuild, os.path.normpath(pkgbuild), "pkgbuild")
    if not unit:
        return
    arrays = parse_arrays(unit.lines)
    scalars = parse_scalars(unit.lines, unit.funcs)
    for arr_name, entries in arrays.items():
        if not (arr_name == "source" or arr_name.startswith("source_")):
            continue
        for entry in entries:
            raw = dequote(entry.value)
            name, _, loc = raw.partition("::")
            if not loc:
                loc = raw
            loc = expand(loc, scalars)
            if re.match(r"^[A-Za-z0-9+.-]+://", loc) or "$" in loc:
                continue
            f = os.path.join(directory, os.path.basename(loc))
            if os.path.isfile(f):
                push(f, os.path.normpath(f), classify(f))


# --------------------------------------------------------------------------
# output
# --------------------------------------------------------------------------

COLORS = {SEV_HIGH: "\033[1;31m", SEV_MEDIUM: "\033[1;33m", SEV_LOW: "\033[36m"}
RESET = "\033[0m"
DIM = "\033[2m"


def render_table(findings: list[Finding], color: bool, out, suppressed: int = 0) -> None:
    if not findings:
        out.write("clean: no findings\n")
        if suppressed:
            out.write("(%d finding(s) hidden by allow rules)\n" % suppressed)
        return
    width = max(len(f.severity) for f in findings)
    idw = max(len(f.id) for f in findings)
    for f in findings:
        loc = "%s:%d" % (f.file, f.line)
        sev = f.severity.upper().ljust(width)
        if color:
            sev = "%s%s%s" % (COLORS[f.severity], sev, RESET)
        out.write("%s  %s  %s\n" % (sev, f.id.ljust(idw), loc))
        pad = " " * (width + 2)
        if color:
            out.write("%s%s%s%s\n" % (pad, DIM, f.evidence, RESET))
            out.write("%s%swhy:     %s%s\n" % (pad, DIM, f.why, RESET))
            out.write("%s%sproceed: %s%s\n" % (pad, DIM, f.proceed, RESET))
        else:
            out.write("%s%s\n" % (pad, f.evidence))
            out.write("%swhy:     %s\n" % (pad, f.why))
            out.write("%sproceed: %s\n" % (pad, f.proceed))
    counts = summarize(findings)
    out.write(
        "\n%d finding(s): %d high, %d medium, %d low%s\n"
        % (
            len(findings),
            counts["high"],
            counts["medium"],
            counts["low"],
            " (%d hidden by allow rules)" % suppressed if suppressed else "",
        )
    )
    render_footer(findings, out)


def render_footer(findings: list[Finding], out) -> None:
    """Short, copy-pasteable ways to move on."""
    worst = max(findings, key=lambda f: SEV_RANK[f.severity])
    pkg = worst.pkg or "<pkgname>"
    host = next((f.host for f in findings if f.host), "")
    out.write("\nIf this is expected:\n")
    if host:
        out.write(
            "  trust that host       echo 'host=%s' >> %s\n" % (host, ALLOW_USER)
        )
    out.write(
        "  accept one rule here  echo 'pkg=%s rule=%s' >> %s\n"
        % (pkg, worst.id, ALLOW_USER)
    )
    out.write(
        "  read it first         less %s   # then re-run this scan\n" % worst.file
    )
    out.write(
        "  build anyway          SENTINEL_SANDBOX=0 makepkg -si"
        "   # skips the sandbox and this scan\n"
    )
    out.write("  allow-file syntax     host=<domain> | rule=<id> | pkg=<pkgname>, '#' comments\n")


def summarize(findings: list[Finding]) -> dict[str, int]:
    counts = {SEV_HIGH: 0, SEV_MEDIUM: 0, SEV_LOW: 0}
    for f in findings:
        counts[f.severity] += 1
    return counts


