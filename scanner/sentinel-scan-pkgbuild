@dataclass
class FileUnit:
    path: str          # path as reported
    kind: str          # "pkgbuild" | "install" | "source"
    text: str
    lines: list[Line] = field(default_factory=list)
    logical: list[LogicalLine] = field(default_factory=list)
    funcs: dict[str, tuple[int, int]] = field(default_factory=dict)
    pkg: str = ""      # owning pkgname/pkgbase, for allow-file scoping


def load_unit(path: str, display: str, kind: str) -> FileUnit | None:
    try:
        with open(path, "rb") as fh:
            data = fh.read()
    except OSError:
        return None
    if b"\x00" in data[:4096]:
        return None  # binary
    text = data.decode("utf-8", errors="surrogateescape")
    unit = FileUnit(display, kind, text)
    unit.lines = strip_comments(text)
    unit.funcs = find_functions(unit.lines)
    unit.logical = join_continuations(unit.lines)
    ranges = {name: rng for name, rng in unit.funcs.items()}
    for ll in unit.logical:
        for name, (start, end) in ranges.items():
            if start <= ll.no <= end:
                ll.func = name
                break
    return unit


class Scanner:
    def __init__(self) -> None:
        self.findings: list[Finding] = []
        self._seen: set[tuple[str, str, int]] = set()

    def add(
        self,
        rule: str,
        unit: FileUnit,
        line: int,
        evidence: str,
        severity: str | None = None,
        why: str | None = None,
        escape: bool = False,
        host: str = "",
    ) -> None:
        default_sev, default_why, proceed = RULES[rule]
        sev = severity or default_sev
        key = (rule, unit.path, line)
        if key in self._seen:
            return
        self._seen.add(key)
        pkg = unit.pkg or "<pkgname>"
        self.findings.append(
            Finding(
                id=rule,
                severity=sev,
                file=unit.path,
                line=line,
                evidence=clean_evidence(evidence, escape_invisible=escape),
                why=why or default_why,
                proceed=proceed.format(pkg=pkg, id=rule, host=host or "<host>"),
                pkg=unit.pkg,
                host=host,
            )
        )

    # ---- rules over code lines -------------------------------------------

    def scan_code(self, unit: FileUnit) -> None:
        is_install = unit.kind == "install"
        for ll in unit.logical:
            code = ll.code
            if not code.strip():
                continue

            def live(m: re.Match | None) -> bool:
                """A real command here, not help text and not a heredoc body."""
                if m is None:
                    return False
                if ll.heredoc:
                    return False
                return not in_printed_text(code, m.start())

            line_host = first_url_host(code)

            # --- net.curl-pipe-shell -------------------------------------
            dl = DOWNLOADER_RE.search(code)
            if live(dl) and (
                pipes_into_shell(code) or (SUBSHELL_EXEC_RE.search(code) and dl)
            ):
                self.add("net.curl-pipe-shell", unit, ll.no, code, host=line_host)

            # --- obf.base64-exec -----------------------------------------
            dec = DECODE_RE.search(code)
            if live(dec) and (
                decode_into_shell(code)
                or re.search(r"\beval\b", code)
                or SUBSHELL_EXEC_RE.search(code)
                or re.search(r"chmod\s+\S*\+x", code)
            ):
                self.add("obf.base64-exec", unit, ll.no, code)

            # --- obf.eval-var --------------------------------------------
            m = EVAL_RE.search(code)
            if live(m) and m and "$" in m.group("arg"):
                self.add("obf.eval-var", unit, ll.no, code)

            # --- pkg.nested-package-manager ------------------------------
            m = PKGMGR_RE.search(code)
            if live(m):
                sev = SEV_HIGH if is_install else SEV_MEDIUM
                why = None
                if not is_install:
                    why = (
                        "runs a language package manager during build, pulling "
                        "code that makepkg's checksums do not cover"
                    )
                self.add("pkg.nested-package-manager", unit, ll.no, code, severity=sev, why=why)

            staging = bool(STAGING_RE.search(code))
            removing = bool(REMOVE_RE.search(code))

            # --- persistence: only when the target is the live system -----
            m = SHELL_RC_RE.search(code)
            if live(m) and WRITE_RE.search(code) and not staging and not removing:
                self.add("persist.shell-rc", unit, ll.no, code)

            m = SYSTEMD_ENABLE_RE.search(code)
            if live(m):
                # `--global`/`--user enable` at install time is the socket
                # activation idiom shipped by pipewire, gnome-keyring, ...
                scoped = re.search(r"systemctl\s+(?:--\S+\s+)*--(?:global|user)\b", code)
                self.add(
                    "persist.systemd-enable",
                    unit,
                    ll.no,
                    code,
                    severity=SEV_MEDIUM if scoped else SEV_HIGH,
                    why=(
                        "enables a unit in every user session from the package "
                        "itself, so it starts without the user asking"
                        if scoped
                        else None
                    ),
                )
            else:
                m = SYSTEMD_WANTS_RE.search(code)
                if live(m) and WRITE_RE.search(code) and not staging:
                    self.add("persist.systemd-enable", unit, ll.no, code)

            m = AUTOSTART_RE.search(code)
            if live(m) and WRITE_RE.search(code) and not staging and not removing:
                self.add("persist.autostart", unit, ll.no, code)

            m = CRON_RE.search(code)
            if live(m) and not staging and not removing:
                if re.search(r"\bcrontab\b", code) or WRITE_RE.search(code):
                    self.add("persist.cron", unit, ll.no, code)

            m = LDPRELOAD_RE.search(code)
            if live(m) and not removing:
                self.add("persist.ld-preload", unit, ll.no, code)
            else:
                m = LDCONF_RE.search(code)
                if live(m) and WRITE_RE.search(code) and not staging:
                    self.add(
                        "persist.ld-preload",
                        unit,
                        ll.no,
                        code,
                        severity=SEV_MEDIUM,
                        why="writes a linker search path onto the live system outside $pkgdir",
                    )

            # --- privilege ------------------------------------------------
            m = SUID_RE.search(code)
            if live(m):
                sev, why = self._priv_severity(code, staging, "setuid/setgid bit")
                self.add("priv.suid", unit, ll.no, code, severity=sev, why=why)
            m = SETCAP_RE.search(code)
            if live(m):
                sev, why = self._priv_severity(code, staging, "file capabilities")
                self.add("priv.setcap", unit, ll.no, code, severity=sev, why=why)

            # --- .install talking to the network --------------------------
            if is_install:
                m = NET_IN_INSTALL_RE.search(code)
                if live(m):
                    self.add("install.network", unit, ll.no, code, host=line_host)

            # --- suspicious hosts anywhere in the file --------------------
            for url in URL_RE.findall(code):
                reason = suspicious_reason(url)
                if reason:
                    self.add(
                        "src.suspicious-host",
                        unit,
                        ll.no,
                        code,
                        why="fetches from %s, which is not a place package sources come from"
                        % reason,
                        host=url_host(url) or "",
                    )

    @staticmethod
    def _priv_severity(code: str, staging: bool, what: str) -> tuple[str, str | None]:
        if staging:
            return (
                SEV_LOW,
                "package ships a binary with %s; review who is allowed to run it" % what,
            )
        if HIGH_TARGET_RE.search(code):
            return (SEV_HIGH, None)
        return (
            SEV_MEDIUM,
            "grants %s to a system path at install time; normal for a few network "
            "tools, suspicious anywhere else" % what,
        )

    # ---- unicode ---------------------------------------------------------

    def scan_unicode(self, unit: FileUnit) -> None:
        for idx, raw in enumerate(unit.text.splitlines(), start=1):
            bad: list[str] = []
            for ch in raw:
                cp = ord(ch)
                if cp < 128:
                    continue
                if is_invisible(ch) or unicodedata.category(ch) in ("Cf", "Cc", "Co", "Cs"):
                    label = "U+%04X" % cp
                    if label not in bad:
                        bad.append(label)
            if not bad:
                continue
            bom_only = bad == ["U+FEFF"] and idx == 1 and raw.startswith("﻿")
            sev = SEV_LOW if bom_only else SEV_HIGH
            why = (
                "file starts with a UTF-8 BOM; harmless but makepkg does not expect it"
                if bom_only
                else "line contains invisible/bidi Unicode (%s) that hides code from review"
                % ", ".join(bad[:6])
            )
            self.add("uni.invisible-chars", unit, idx, raw, severity=sev, why=why, escape=True)

    # ---- source array / checksum rules ----------------------------------

    def scan_sources(self, unit: FileUnit) -> list[tuple[str, str]]:
        """Returns [(local filename, ...)] found in source arrays."""
        arrays = parse_arrays(unit.lines)
        scalars = parse_scalars(unit.lines, unit.funcs)
        url_val = expand(scalars.get("url", ""), scalars)
        uhost = url_host(url_val)
        ufamily = FORGE_FAMILY.get(uhost or "")
        uowner = _forge_owner(uhost, url_path(url_val)) if uhost else None

        locals_found: list[tuple[str, str]] = []
        sums_names = ("sha256sums", "sha512sums", "sha384sums", "sha224sums",
                      "sha1sums", "b2sums", "md5sums", "cksums")

        for arr_name, entries in arrays.items():
            if not (arr_name == "source" or arr_name.startswith("source_")):
                continue
            suffix = arr_name[len("source"):]
            sums: dict[int, ArrayEntry] = {}
            for sname in sums_names:
                for key in (sname + suffix, sname):
                    for i, e in enumerate(arrays.get(key, [])):
                        if dequote(e.value).upper() == "SKIP":
                            sums.setdefault(i, e)
                    if key in arrays:
                        break

            for idx, entry in enumerate(entries):
                raw = dequote(entry.value)
                name, _, loc = raw.partition("::")
                if not loc:
                    loc, name = raw, ""
                loc_x = expand(loc, scalars)
                is_vcs = bool(
                    re.match(r"^(git|hg|svn|bzr|fossil)(\+|://)", loc_x)
                    or re.match(r"^[a-z]+\+(https?|ssh|file)://", loc_x)
                )
                remote = bool(re.match(r"^[A-Za-z0-9+.-]+://", loc_x))

                if not remote:
                    locals_found.append((loc_x, name))
                    continue

                reason = suspicious_reason(loc_x)
                if reason:
                    self.add(
                        "src.suspicious-host",
                        unit,
                        entry.no,
                        raw,
                        why="source is fetched from %s, which is not a place package sources come from"
                        % reason,
                        host=url_host(loc_x) or "",
                    )
                else:
                    shost = url_host(loc_x)
                    if shost:
                        self._host_mismatch(unit, entry, raw, shost, loc_x, uhost, ufamily, uowner, scalars)

                if not is_vcs and idx in sums:
                    e = sums[idx]
                    self.add(
                        "src.skip-checksum",
                        unit,
                        e.no,
                        "%s -> %s" % (raw, dequote(e.value)),
                    )
        return locals_found

    def _host_mismatch(
        self,
        unit: FileUnit,
        entry: ArrayEntry,
        raw: str,
        shost: str,
        loc: str,
        uhost: str | None,
        ufamily: str | None,
        uowner: str | None,
        scalars: dict[str, str],
    ) -> None:
        sfamily = FORGE_FAMILY.get(shost)
        if sfamily and ufamily == sfamily and uowner:
            sowner = _forge_owner(shost, url_path(loc))
            if sowner and sowner.lower() != uowner.lower():
                self.add(
                    "src.host-mismatch",
                    unit,
                    entry.no,
                    raw,
                    why="source comes from %s account '%s' but url= points at '%s'"
                    % (sfamily, sowner, uowner),
                    host=shost,
                )
            return
        if is_known_host(shost):
            return
        if uhost and registrable(shost) == registrable(uhost):
            return
        # vendor CDN heuristic: shares a >=4 char label with url= or pkgname
        tokens = set()
        if uhost:
            tokens.update(re.split(r"[.-]", registrable(uhost))[:-1])
        for key in ("pkgname", "pkgbase", "_pkgname"):
            val = expand(scalars.get(key, ""), scalars)
            tokens.update(re.split(r"[-_]", val))
        tokens = {t.lower() for t in tokens if len(t) >= 4}
        slabels = {t.lower() for t in re.split(r"[.-]", shost) if len(t) >= 4}
        if tokens & slabels:
            self.add(
                "src.host-mismatch",
                unit,
                entry.no,
                raw,
                severity=SEV_LOW,
                why="source host %s differs from url= host %s but looks like the same vendor"
                % (shost, uhost or "?"),
                host=shost,
            )
            return
        self.add(
            "src.host-mismatch",
            unit,
            entry.no,
            raw,
            why="source host %s is neither a known forge/CDN nor related to url= (%s)"
            % (shost, uhost or "unset"),
            host=shost,
        )


def _forge_owner(host: str | None, path: str) -> str | None:
    if not host:
        return None
    parts = [p for p in path.split("/") if p]
    if not parts:
        return None
    if host.endswith("sr.ht"):
        return parts[0].lstrip("~")
    return parts[0]


