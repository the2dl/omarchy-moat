# --------------------------------------------------------------------------
# shell-ish lexing
# --------------------------------------------------------------------------


@dataclass
class Line:
    """One physical line with comments removed."""

    no: int
    code: str
    heredoc: bool = False


@dataclass
class LogicalLine:
    """Continuation-joined, comment-stripped line."""

    no: int
    code: str
    func: str | None = None
    heredoc: bool = False


HEREDOC_DELIM_RE = re.compile(r"^-?\s*(?:\"([^\"]+)\"|'([^']+)'|([A-Za-z_][A-Za-z0-9_]*))")


def strip_comments(text: str) -> list[Line]:
    """Comment-strip every physical line, carrying quote state across lines.

    Heredoc bodies are passed through verbatim and marked, both so that message
    text like `cat <<EOM ... $ pacman -S foo ... EOM` is not mistaken for a
    command and so that an apostrophe in prose cannot corrupt the quote state
    for the rest of the file.
    """
    out: list[Line] = []
    quote: str | None = None
    pending_heredocs: list[str] = []
    for idx, raw in enumerate(text.splitlines(), start=1):
        if pending_heredocs:
            out.append(Line(idx, raw.rstrip(), heredoc=True))
            if raw.strip() == pending_heredocs[0]:
                pending_heredocs.pop(0)
            continue
        buf: list[str] = []
        i = 0
        n = len(raw)
        prev = "\n"  # start of line counts as a word boundary
        while i < n:
            ch = raw[i]
            if quote == "'":
                buf.append(ch)
                if ch == "'":
                    quote = None
                i += 1
                prev = ch
                continue
            if quote == '"':
                buf.append(ch)
                if ch == "\\" and i + 1 < n:
                    buf.append(raw[i + 1])
                    i += 2
                    prev = ""
                    continue
                if ch == '"':
                    quote = None
                i += 1
                prev = ch
                continue
            if ch == "\\":
                buf.append(ch)
                if i + 1 < n:
                    buf.append(raw[i + 1])
                    i += 2
                else:
                    i += 1
                prev = ""
                continue
            if ch in "'\"":
                quote = ch
                buf.append(ch)
                i += 1
                prev = ch
                continue
            if ch == "#" and (prev in ("\n", "", " ", "\t", ";", "|", "&", "(", ")", "{")):
                break
            if ch == "<" and raw[i : i + 3] == "<<<":  # herestring, not heredoc
                buf.append("<<<")
                prev = "<"
                i += 3
                continue
            if ch == "<" and raw[i : i + 2] == "<<":
                m = HEREDOC_DELIM_RE.match(raw[i + 2 :])
                if m:
                    pending_heredocs.append(m.group(1) or m.group(2) or m.group(3))
            buf.append(ch)
            prev = ch
            i += 1
        out.append(Line(idx, "".join(buf).rstrip()))
    return out


def join_continuations(lines: list[Line]) -> list[LogicalLine]:
    out: list[LogicalLine] = []
    pending: list[str] = []
    start = 0
    heredoc = False
    for ln in lines:
        code = ln.code
        cont = (
            code.endswith("\\") and not code.endswith("\\\\") and not ln.heredoc
        )
        if cont:
            code = code[:-1]
        if not pending:
            start = ln.no
            heredoc = ln.heredoc
        pending.append(code)
        if not cont:
            out.append(LogicalLine(start, "".join(pending), heredoc=heredoc))
            pending = []
    if pending:
        out.append(LogicalLine(start, "".join(pending), heredoc=heredoc))
    return out


FUNC_RE = re.compile(r"^\s*(?:function\s+)?([A-Za-z_][A-Za-z0-9_:.+-]*)\s*\(\s*\)\s*\{?\s*$")


def find_functions(lines: list[Line]) -> dict[str, tuple[int, int]]:
    """name -> (first line, last line) using brace counting."""
    funcs: dict[str, tuple[int, int]] = {}
    i = 0
    while i < len(lines):
        m = FUNC_RE.match(lines[i].code)
        if not m:
            i += 1
            continue
        name = m.group(1)
        depth = lines[i].code.count("{") - lines[i].code.count("}")
        start = lines[i].no
        j = i + 1
        if depth <= 0:
            # opening brace on the following line
            while j < len(lines) and not lines[j].code.strip():
                j += 1
            if j < len(lines) and lines[j].code.strip().startswith("{"):
                depth = 1
                j += 1
            else:
                i += 1
                continue
        while j < len(lines) and depth > 0:
            depth += lines[j].code.count("{") - lines[j].code.count("}")
            j += 1
        funcs[name] = (start, lines[min(j, len(lines)) - 1].no)
        i = j
    return funcs


@dataclass
class ArrayEntry:
    value: str
    no: int


def parse_arrays(lines: list[Line]) -> dict[str, list[ArrayEntry]]:
    """Collect NAME=( ... ) arrays with the source line of each entry."""
    arrays: dict[str, list[ArrayEntry]] = {}
    assign = re.compile(r"^\s*(?:export\s+|declare\s+-\w+\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*(\+?=)\s*\(")
    i = 0
    while i < len(lines):
        m = assign.match(lines[i].code)
        if not m:
            i += 1
            continue
        name = m.group(1)
        # char stream with line numbers, starting just after the '('
        stream: list[tuple[str, int]] = []
        depth = 0
        j = i
        pos = m.end()
        done = False
        while j < len(lines) and not done:
            code = lines[j].code
            k = pos if j == i else 0
            if j == i:
                depth = 1
            while k < len(code):
                ch = code[k]
                if ch == "(":
                    depth += 1
                elif ch == ")":
                    depth -= 1
                    if depth == 0:
                        done = True
                        break
                stream.append((ch, lines[j].no))
                k += 1
            if not done:
                stream.append((" ", lines[j].no))
            j += 1
        entries = _split_entries(stream)
        arrays.setdefault(name, []).extend(entries)
        i = j if j > i else i + 1
    return arrays


def _split_entries(stream: list[tuple[str, int]]) -> list[ArrayEntry]:
    entries: list[ArrayEntry] = []
    cur: list[str] = []
    cur_no = 0
    quote: str | None = None
    depth = 0
    for ch, no in stream:
        if quote:
            if ch == quote:
                quote = None
            else:
                cur.append(ch)
            continue
        if ch in "'\"":
            quote = ch
            if not cur:
                cur_no = no
            continue
        if ch in "({[":
            depth += 1
        elif ch in ")}]":
            depth = max(0, depth - 1)
        if ch.isspace() and depth == 0:
            if cur:
                entries.append(ArrayEntry("".join(cur), cur_no))
                cur = []
            continue
        if not cur:
            cur_no = no
        cur.append(ch)
    if cur:
        entries.append(ArrayEntry("".join(cur), cur_no))
    return entries


SCALAR_RE = re.compile(
    r"^\s*(?:export\s+|local\s+|declare\s+-\w+\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$"
)


def parse_scalars(lines: list[Line], funcs: dict[str, tuple[int, int]]) -> dict[str, str]:
    """Top-level scalar assignments (outside any function)."""
    in_func = set()
    for start, end in funcs.values():
        in_func.update(range(start, end + 1))
    out: dict[str, str] = {}
    for ln in lines:
        if ln.no in in_func:
            continue
        m = SCALAR_RE.match(ln.code)
        if not m:
            continue
        val = m.group(2).strip()
        if val.startswith("("):
            continue
        out[m.group(1)] = dequote(val)
    return out


def dequote(s: str) -> str:
    s = s.strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "'\"":
        return s[1:-1]
    return s


VAR_RE = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)([^}]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)")


def expand(value: str, vars: dict[str, str], depth: int = 0) -> str:
    """Best-effort variable expansion; unknown names are left as-is."""
    if depth > 6 or "$" not in value:
        return value

    def sub(m: re.Match[str]) -> str:
        name = m.group(1) or m.group(3)
        op = m.group(2) or ""
        if name not in vars:
            return m.group(0)
        val = expand(vars[name], vars, depth + 1)
        if op:
            if op == "^":
                val = val[:1].upper() + val[1:]
            elif op == "^^":
                val = val.upper()
            elif op == ",":
                val = val[:1].lower() + val[1:]
            elif op == ",,":
                val = val.lower()
            elif op.startswith(("#", "%")):
                pass  # pattern removal: keep the value, close enough for hosts
            else:
                return m.group(0)
        return val

    return VAR_RE.sub(sub, value)


# --------------------------------------------------------------------------
# url helpers
# --------------------------------------------------------------------------


def url_host(url: str) -> str | None:
    m = re.match(r"^[A-Za-z0-9+.-]+://(?:[^/@\s]*@)?\[?([^/\]\s:]+)\]?", url)
    if not m:
        return None
    host = m.group(1).lower().rstrip(".")
    if "$" in host or not host:
        return None
    return host


def url_path(url: str) -> str:
    m = re.match(r"^[A-Za-z0-9+.-]+://[^/\s]+(/[^\s?#]*)", url)
    return m.group(1) if m else "/"


def registrable(host: str) -> str:
    parts = host.split(".")
    if len(parts) <= 2:
        return host
    if ".".join(parts[-2:]) in MULTI_SUFFIXES:
        return ".".join(parts[-3:])
    return ".".join(parts[-2:])


def is_known_host(host: str) -> bool:
    for good in KNOWN_HOSTS:
        if host == good or host.endswith("." + good):
            return True
    return False


def is_raw_ip(host: str) -> bool:
    if IPV4_RE.match(host):
        octets = [int(p) for p in host.split(".")]
        if any(o > 255 for o in octets):
            return False
        if octets[0] in (0, 127):  # loopback / unspecified: noise, not exfil
            return False
        return True
    if ":" in host and re.match(r"^[0-9a-f:]+$", host):
        return host not in ("::1", "::")
    return False


def first_url_host(code: str) -> str:
    for url in URL_RE.findall(code):
        host = url_host(url)
        if host:
            return host
    return ""


def suspicious_reason(url: str) -> str | None:
    low = url.lower()
    for pat in SUSPICIOUS_URL_SUBSTRINGS:
        if pat in low:
            return pat
    host = url_host(url)
    if not host:
        return None
    if host.endswith(".onion"):
        return ".onion hidden service"
    for pat in SUSPICIOUS_HOST_SUBSTRINGS:
        if pat in host:
            return host
    if is_raw_ip(host):
        return "raw IP literal %s" % host
    return None


# --------------------------------------------------------------------------
# findings
# --------------------------------------------------------------------------


@dataclass
class Finding:
    id: str
    severity: str
    file: str
    line: int
    evidence: str
    why: str
    proceed: str
    pkg: str = ""     # owning package, for allow-file matching
    host: str = ""    # host involved, for allow-file matching

    def as_dict(self) -> dict:
        return {
            "id": self.id,
            "severity": self.severity,
            "file": self.file,
            "line": self.line,
            "evidence": self.evidence,
            "why": self.why,
            "proceed": self.proceed,
        }


# --------------------------------------------------------------------------
# allow file:  host=<domain> | rule=<id> | pkg=<pkgname>, '#' comments.
# Keys on one line are ANDed, so `pkg=foo rule=src.skip-checksum` skips that
# rule for that package only.  Globs are allowed (`rule=persist.*`).
# --------------------------------------------------------------------------

ALLOW_KEYS = ("host", "rule", "pkg")


def allow_file_paths(extra: list[str] | None = None) -> list[str]:
    env = os.environ.get("SENTINEL_SCANNER_ALLOW", "")
    paths = [ALLOW_SYSTEM]
    xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(
        os.path.expanduser("~"), ".config"
    )
    paths.append(os.path.join(xdg, "sentinel", "scanner-allow.conf"))
    paths.extend(p for p in env.split(":") if p)
    paths.extend(extra or [])
    return paths


def load_allow(paths: list[str]) -> list[dict[str, str]]:
    entries: list[dict[str, str]] = []
    for path in paths:
        try:
            with open(os.path.expanduser(path), encoding="utf-8", errors="replace") as fh:
                body = fh.read()
        except OSError:
            continue
        for raw in body.splitlines():
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            entry: dict[str, str] = {}
            for tok in re.split(r"[\s,]+", line):
                key, _, val = tok.partition("=")
                if key in ALLOW_KEYS and val:
                    entry[key] = val.strip("'\"")
            if entry:
                entries.append(entry)
    return entries


def host_matches(host: str, pattern: str) -> bool:
    host = host.lower()
    pattern = pattern.lower().lstrip(".")
    if not host:
        return False
    return host == pattern or host.endswith("." + pattern) or fnmatch.fnmatch(host, pattern)


def is_allowed(f: Finding, entries: list[dict[str, str]]) -> bool:
    for entry in entries:
        ok = True
        for key, val in entry.items():
            if key == "rule":
                ok = ok and (f.id == val or fnmatch.fnmatch(f.id, val))
            elif key == "pkg":
                ok = ok and bool(f.pkg) and (f.pkg == val or fnmatch.fnmatch(f.pkg, val))
            elif key == "host":
                ok = ok and host_matches(f.host, val)
            if not ok:
                break
        if ok:
            return True
    return False


def clean_evidence(text: str, escape_invisible: bool = False) -> str:
    out: list[str] = []
    for ch in text:
        if escape_invisible and (is_invisible(ch) or (ord(ch) > 127 and unicodedata.category(ch) in ("Cf", "Cc", "Co", "Cs"))):
            out.append("\\u%04x" % ord(ch) if ord(ch) <= 0xFFFF else "\\U%08x" % ord(ch))
        elif ch in "\t\r\n":
            out.append(" ")
        else:
            out.append(ch)
    s = re.sub(r"\s+", " ", "".join(out)).strip()
    if len(s) > EVIDENCE_MAX:
        s = s[: EVIDENCE_MAX - 3] + "..."
    return s


INVISIBLE_RANGES = (
    (0x00AD, 0x00AD),   # soft hyphen
    (0x061C, 0x061C),   # arabic letter mark
    (0x180E, 0x180E),   # mongolian vowel separator
    (0x200B, 0x200F),   # zero width space .. RLM
    (0x2028, 0x202E),   # line/para sep, bidi embedding/override
    (0x2060, 0x2064),   # word joiner .. invisible plus
    (0x2066, 0x206F),   # bidi isolates, deprecated formatting
    (0x3164, 0x3164),   # hangul filler (GlassWorm)
    (0xFE00, 0xFE0F),   # variation selectors
    (0xFEFF, 0xFEFF),   # BOM / zero width no-break space
    (0xFFA0, 0xFFA0),   # halfwidth hangul filler (GlassWorm)
    (0xE0000, 0xE007F),  # tag characters
    (0xE0100, 0xE01EF),  # variation selectors supplement (GlassWorm)
)


def is_invisible(ch: str) -> bool:
    cp = ord(ch)
    for lo, hi in INVISIBLE_RANGES:
        if lo <= cp <= hi:
            return True
    return False


# --------------------------------------------------------------------------
# pattern helpers
# --------------------------------------------------------------------------

DOWNLOADER_RE = re.compile(
    r"\b(curl|wget2?|aria2c|axel|httpie|lwp-download|snarf|hurl)\b"
)
SINKS = {
    "bash", "sh", "zsh", "dash", "ksh", "fish", "csh", "tcsh", "ash",
    "python", "python2", "python3", "perl", "ruby", "node", "nodejs",
    "php", "lua", "luajit", "eval", "source", ".",
}
PREFIX_WORDS = {"sudo", "doas", "env", "exec", "command", "time", "nohup", "setsid", "nice", "xargs"}

DECODE_RE = re.compile(
    r"base64\s+(?:-{1,2}[A-Za-z]*d[A-Za-z]*|--decode)\b"
    r"|base32\s+-{1,2}[A-Za-z]*d\b"
    r"|\bxxd\s+(?:-\S+\s+)*-r\b"
    r"|\buudecode\b"
    r"|\bopenssl\s+(?:enc|base64)\b[^|;]*\s-d\b"
    r"|b64decode"
    r"|\bgzip\s+-d\s*(?:$|\||<)"
    r"|\bzcat\b"
)
EVAL_RE = re.compile(r"(?:^|[;&|(]|\bthen\b|\bdo\b|\belse\b|\s)eval\s+(?P<arg>\S.*)$")
PKGMGR_RE = re.compile(
    r"\b(?:npm|pnpm|yarn|bun)\s+(?:[-\w=./]+\s+)*(?:install|add|ci|i)\b"
    r"|\b(?:npx|bunx|pnpx)\s+\S"
    r"|\b(?:pip|pip3|pip2)\s+(?:[-\w=./]+\s+)*install\b"
    r"|\bpython3?\s+-m\s+pip\s+(?:[-\w=./]+\s+)*install\b"
    r"|\buv\s+(?:pip\s+)?(?:install|add|tool\s+install)\b"
    r"|\bcargo\s+install\b"
    r"|\bgem\s+install\b"
    r"|\bgo\s+install\b"
    r"|\bpoetry\s+(?:install|add)\b"
    r"|\bcomposer\s+(?:install|require)\b"
    r"|\bpipx\s+install\b"
)
WRITE_RE = re.compile(
    r">>?|\btee\b|\bsed\s+-\S*i|\bcp\b|\bmv\b|\bln\s+-\S*s|\binstall\s+-|\bdd\b|\bpython3?\s+-c\b|\bcat\b"
)
REMOVE_RE = re.compile(r"\b(rm|rmdir|unlink|find)\b")
STAGING_RE = re.compile(r"\$\{?(pkgdir|srcdir|DESTDIR)\b|\bDESTDIR=")

SHELL_RC_RE = re.compile(
    r"(?:~|\$\{?HOME\}?|/home/[^/\s\"']+|/root)/\.(?:bashrc|zshrc|profile|bash_profile"
    r"|bash_login|zprofile|zshenv|zlogin|kshrc|config/fish/config\.fish)"
    r"|/etc/profile(?:\.d/[^\s\"';]*)?\b"
    r"|/etc/bash\.bashrc\b"
    r"|/etc/zsh/z(?:shrc|shenv|profile)\b"
)
# NB: /usr/lib/systemd/user is where units are *shipped*; only the live
# session dirs count as persistence.
AUTOSTART_RE = re.compile(
    r"(?:\.config/autostart|/etc/xdg/autostart|\.config/systemd/user"
    r"|\.config/hypr/autostart)"
)
CRON_RE = re.compile(
    r"\bcrontab\b|/etc/cron\.(?:d|daily|hourly|weekly|monthly)\b|/etc/crontab\b"
    r"|/var/spool/cron\b|\bsystemd-run\b[^\n]*--on-(?:calendar|boot)"
)
LDPRELOAD_RE = re.compile(r"/etc/ld\.so\.preload\b|\bLD_PRELOAD\s*=")
LDCONF_RE = re.compile(r"/etc/ld\.so\.conf(?:\.d[^\s\"';]*)?\b")
SUID_RE = re.compile(
    r"\bchmod\s+(?:-\S+\s+)*(?:[ugoa]*\+[rwxXst]*s[rwxXst]*|[0-7]*[2467][0-7]{3})\b"
    r"|\binstall\b[^\n]*?-\w*m\s?0?[2467][0-7]{3}\b"
)
SETCAP_RE = re.compile(r"\bsetcap\b")
# enable/start only: `systemctl disable --now` in pre_remove is legitimate.
SYSTEMD_ENABLE_RE = re.compile(
    r"\bsystemctl\b(?:\s+--[\w=/.:-]+)*\s+(?:enable|reenable|link|preset|start)\b"
)
SYSTEMD_WANTS_RE = re.compile(r"/etc/systemd/system/[^\s\"';]*\.(?:wants|requires)\b")
NET_IN_INSTALL_RE = re.compile(
    r"\b(curl|wget2?|aria2c|axel|lwp-download)\b"
    r"|\bgit\s+(?:clone|pull|fetch|remote)\b"
    r"|/dev/tcp/"
    r"|\b(?:nc|ncat|netcat|socat)\s+-"
    r"|\b(?:ssh|scp|sftp)\s+[^\s]*@"
    r"|\brsync\s+[^\n]*(?:::|@)"
    r"|\bopenssl\s+s_client\b"
    r"|\bgpg\b[^\n]*--(?:recv-keys|keyserver|locate-key)"
    r"|\bpython3?\s+-c\b[^\n]*(?:urllib|requests|socket|http\.client)"
    r"|\bnpm\b|\bpip3?\b|\bcargo\s+install\b"
)

# Commands that only print text: a rule hit inside their quoted argument is a
# help message, not an action (`echo "run: systemctl --user enable foo"`).
PRINTERS = {
    "echo", "printf", "print", "cat", "msg", "msg2", "note", "warning",
    "error", "plain", "tee", "logger", "notify-send",
}

# A privilege change aimed at one of these is escalation, not packaging.
HIGH_TARGET_RE = re.compile(
    r"(?:~|\$\{?HOME\}?|/home/|/root/|/tmp/|/var/tmp/|/dev/shm/)"
    r"|/(?:ba|z|da|k|a)?sh\b|/python[0-9.]*\b|/perl\b|/ruby\b|/node\b"
    r"|/env\b|/find\b|/awk\b|/vim?\b|/nmap\b|/tar\b|/dd\b|/cp\b"
)


def split_pipeline(code: str) -> list[str]:
    segs: list[str] = []
    cur: list[str] = []
    quote: str | None = None
    depth = 0
    i = 0
    while i < len(code):
        ch = code[i]
        if quote:
            cur.append(ch)
            if ch == "\\" and quote == '"' and i + 1 < len(code):
                cur.append(code[i + 1])
                i += 2
                continue
            if ch == quote:
                quote = None
            i += 1
            continue
        if ch in "'\"":
            quote = ch
            cur.append(ch)
            i += 1
            continue
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            depth = max(0, depth - 1)
        if ch == "|" and depth == 0:
            if i + 1 < len(code) and code[i + 1] == "|":
                cur.append("||")
                i += 2
                continue
            segs.append("".join(cur))
            cur = []
            i += 1
            continue
        cur.append(ch)
        i += 1
    segs.append("".join(cur))
    return segs


def first_word(seg: str) -> str:
    for tok in seg.replace("(", " ").split():
        t = tok.strip("{}();&")
        if not t or "=" in t and not t.startswith("$"):
            continue
        if t in PREFIX_WORDS:
            continue
        return os.path.basename(t.strip("\"'"))
    return ""


def pipes_into_shell(code: str) -> bool:
    segs = split_pipeline(code)
    if len(segs) < 2:
        return False
    seen_dl = False
    for seg in segs:
        if seen_dl and first_word(seg) in SINKS:
            return True
        if DOWNLOADER_RE.search(seg):
            seen_dl = True
    return False


def decode_into_shell(code: str) -> bool:
    segs = split_pipeline(code)
    seen = False
    for seg in segs:
        if seen and first_word(seg) in SINKS:
            return True
        if DECODE_RE.search(seg):
            seen = True
    return False


SUBSHELL_EXEC_RE = re.compile(
    r"\b(?:bash|sh|zsh|dash|python3?|perl|ruby|node|eval|source)\b(?:\s+-\S+)*\s*"
    r"(?:[\"']?\$\(|<\()"
)


def quoted_spans(code: str) -> list[tuple[int, int]]:
    spans: list[tuple[int, int]] = []
    quote: str | None = None
    start = 0
    i = 0
    while i < len(code):
        ch = code[i]
        if quote:
            if ch == "\\" and quote == '"':
                i += 2
                continue
            if ch == quote:
                spans.append((start, i))
                quote = None
        elif ch in "'\"":
            quote = ch
            start = i
        i += 1
    if quote:
        spans.append((start, len(code)))
    return spans


def in_printed_text(code: str, pos: int) -> bool:
    """True if pos sits inside a quoted argument of a printing command."""
    segs = split_pipeline(code)
    if not segs:
        return False
    first = segs[0]
    if len(first) <= pos:  # the hit is downstream of a pipe: it really runs
        return False
    if first_word(first) not in PRINTERS:
        return False
    return any(a < pos < b for a, b in quoted_spans(code))


