# main
# --------------------------------------------------------------------------


def pkgname_of(directory: str) -> str:
    """pkgbase/pkgname of the PKGBUILD in `directory`, for allow-file scoping."""
    pkgbuild = os.path.join(directory, "PKGBUILD")
    unit = load_unit(pkgbuild, pkgbuild, "pkgbuild")
    if unit is None:
        return ""
    scalars = parse_scalars(unit.lines, unit.funcs)
    for key in ("pkgbase", "pkgname"):
        if key in scalars:
            val = expand(scalars[key], scalars).strip()
            if val and "$" not in val:
                return val
    arrays = parse_arrays(unit.lines)
    for key in ("pkgbase", "pkgname"):
        if arrays.get(key):
            val = expand(dequote(arrays[key][0].value), scalars).strip()
            if val and "$" not in val:
                return val
    return ""


def scan_paths(paths: list[str], warn=lambda m: None) -> list[Finding]:
    scanner = Scanner()
    pkg_cache: dict[str, str] = {}
    for fs, display, kind in collect_targets(paths, warn):
        unit = load_unit(fs, display, kind)
        if unit is None:
            continue
        directory = os.path.dirname(fs) or "."
        if directory not in pkg_cache:
            pkg_cache[directory] = pkgname_of(directory)
        unit.pkg = pkg_cache[directory]
        scanner.scan_unicode(unit)
        scanner.scan_code(unit)
        if kind == "pkgbuild":
            scanner.scan_sources(unit)
    findings = scanner.findings
    findings.sort(key=lambda f: (f.file, f.line, -SEV_RANK[f.severity], f.id))
    return findings


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="sentinel-scan-pkgbuild",
        description="Static review of PKGBUILD / .install / local source files.",
    )
    ap.add_argument("paths", metavar="PATH", nargs="*", default=None,
                    help="files or directories to scan (default: .)")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--min-severity", choices=(SEV_LOW, SEV_MEDIUM, SEV_HIGH),
                    default=SEV_LOW, help="drop findings below this severity")
    ap.add_argument("--quiet", "-q", action="store_true",
                    help="print nothing; use the exit code (JSON still prints with --json)")
    ap.add_argument("--no-color", action="store_true", help="never colorize")
    ap.add_argument("--allow-file", metavar="PATH", action="append", default=[],
                    help="extra allow file (in addition to %s and %s)"
                         % (ALLOW_SYSTEM, ALLOW_USER))
    ap.add_argument("--no-allow", action="store_true",
                    help="ignore all allow files")
    ap.add_argument("--version", action="version", version="sentinel-scan-pkgbuild " + VERSION)
    args = ap.parse_args(argv)

    paths = args.paths or ["."]
    warnings: list[str] = []
    findings = scan_paths(paths, warnings.append)

    allow = [] if args.no_allow else load_allow(allow_file_paths(args.allow_file))
    if allow:
        kept = [f for f in findings if not is_allowed(f, allow)]
        suppressed = len(findings) - len(kept)
        findings = kept
    else:
        suppressed = 0

    floor = SEV_RANK[args.min_severity]
    findings = [f for f in findings if SEV_RANK[f.severity] >= floor]
    counts = summarize(findings)

    if args.json:
        json.dump(
            {"findings": [f.as_dict() for f in findings],
             "summary": {"high": counts[SEV_HIGH], "medium": counts[SEV_MEDIUM],
                         "low": counts[SEV_LOW]}},
            sys.stdout,
            indent=2,
        )
        sys.stdout.write("\n")
    elif not args.quiet:
        color = (not args.no_color) and sys.stdout.isatty() and not os.environ.get("NO_COLOR")
        render_table(findings, color, sys.stdout, suppressed)

    if not args.quiet:
        for w in warnings:
            sys.stderr.write("sentinel-scan-pkgbuild: %s\n" % w)

    if counts[SEV_HIGH]:
        return 2
    if counts[SEV_MEDIUM]:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
